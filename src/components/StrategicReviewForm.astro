---
import { ArrowRight, ArrowLeft } from '@lucide/astro';

interface Props {
  readonly sourcePath: string;
  readonly webhookUrl: string;
}

interface ChoiceOption {
  readonly label: string;
  readonly value: string;
}

const { sourcePath, webhookUrl }: Props = Astro.props;
const consultancyAmount = import.meta.env.PUBLIC_CONSULTANCY_AMOUNT;
const usDollar = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  currencyDisplay: 'code'
});

const formSentCookieName = 'strategic_review_form_status';
const formSentCookieValue = 'form sent';

const roleOptions: readonly ChoiceOption[] = [
  { label: "Founder / CEO", value: "Founder / CEO" },
  { label: "CTO / VP of Engineering", value: "CTO / VP of Engineering" },
  { label: "Product Lead", value: "Product Lead" },
  { label: "Other", value: "Other" },
];
const engineeringTeamSizeOptions: readonly ChoiceOption[] = [
  { label: "1-5 engineers", value: "1-5 engineers" },
  { label: "5-10 engineers", value: "5-10 engineers" },
  { label: "10-15 engineers", value: "10-15 engineers" },
  { label: "15+ engineers", value: "15+ engineers" },
  { label: "We don't have a dev team yet", value: "We don't have a dev team yet" },
];
const implementationCapacityOptions: readonly ChoiceOption[] = [
  { label: "Yes, we are ready to execute", value: "Yes, we are ready to execute" },
  {
    label: "No, we are looking for someone to code the solution",
    value: "No, we are looking for someone to code the solution",
  },
];
---

<div data-strategic-review-form class="review-form-root">
  <div class="review-form-message" data-form-message role="status" aria-live="polite" hidden />

  <form data-review-form class="review-form">
    <section data-step-panel="contact" class="review-step">
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 1 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">
          Business information
        </h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="fullName">
          <span class="review-label">Contact full name <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="fullName"
            name="fullName"
            type="text"
            autocomplete="name"
            required
          />
        </label>

        <label class="review-field" for="workEmail">
          <span class="review-label">Email <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="workEmail"
            name="workEmail"
            type="email"
            autocomplete="email"
            placeholder="Where I should send the next steps"
            required
          />
        </label>

        <label class="review-field" for="companyWebsite">
          <span class="review-label">Company website <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="companyWebsite"
            name="companyWebsite"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="I'll use this to research your product before our call"
            required
          />
        </label>

        <label class="review-field" for="linkedinProfile">
          <span class="review-label">LinkedIn profile <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="linkedinProfile"
            name="linkedinProfile"
            type="url"
            inputmode="url"
            autocomplete="url"
            required
          />
        </label>

        <label class="review-field" for="role">
          <span class="review-label">Your role <span class="review-required">*</span></span>
          <select class="review-input review-select" id="role" name="role" required>
            <option value="">Select your role</option>
            {roleOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-primary" data-action="next-contact">
          Continue
          <ArrowRight />
        </button>
      </div>
    </section>

    <section data-step-panel="qualification" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 2 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Fit & readiness</h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="engineeringTeamSize">
          <span class="review-label">Engineering team size <span class="review-required">*</span></span>
          <select
            class="review-input review-select"
            id="engineeringTeamSize"
            name="engineeringTeamSize"
            required
          >
            <option value="">Select your team size</option>
            {engineeringTeamSizeOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <label class="review-field" for="implementationCapacity">
          <span class="review-label">Implementation capacity <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Do you have a dedicated team ready to implement the recommended roadmap?
          </span>
          <select
            class="review-input review-select"
            id="implementationCapacity"
            name="implementationCapacity"
            required
          >
            <option value="">Select your implementation capacity</option>
            {implementationCapacityOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-contact">
          <ArrowLeft /> Back
        </button>
        <button type="button" class="review-button review-button-primary" data-action="next-qualification">
          Continue to technical details
          <ArrowRight />
        </button>
      </div>
    </section>

    <section data-step-panel="diagnostic" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 3 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Diagnostic focus</h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="primaryTechnicalBottleneck">
          <span class="review-label">
            What is the primary technical bottleneck you need to solve? <span class="review-required">*</span>
          </span>
          <span class="review-step-copy review-compact-copy">
            Please provide specific context, describe where the friction is (e.g. &quot;Our API
            response time spikes to 5s during peak hours&quot;).
          </span>
          <textarea
            class="review-input review-textarea"
            id="primaryTechnicalBottleneck"
            name="primaryTechnicalBottleneck"
            placeholder="Provide a brief summary of the symptoms and what you've tried so far to fix it"
            required
            rows="5"
          />
        </label>

        <label class="review-field" for="estimatedBusinessImpact">
          <span class="review-label">Estimated business impact <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Help me quantify the cost of inaction. If this issue persists, how many engineering
            hours are wasted per week? Are you losing customers due to performance, or is a major
            launch blocked?
          </span>
          <textarea
            class="review-input review-textarea"
            id="estimatedBusinessImpact"
            name="estimatedBusinessImpact"
            placeholder="We estimate 20% of our dev time is spent on manual hotfixes, or Slow checkout is causing a measurable 15% drop in conversion."
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="currentTechStack">
          <span class="review-label">Current tech stack <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            List your core technologies and infrastructure setup.
          </span>
          <textarea
            class="review-input review-textarea"
            id="currentTechStack"
            name="currentTechStack"
            placeholder="High-level languages, Cloud provider, database, monitoring, etc"
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="specificDeadlinesOrConstraints">
          <span class="review-label">Specific deadlines or constraints</span>
          <span class="review-step-copy review-compact-copy">
            Please note I work asynchronously on a specific schedule.
          </span>
          <textarea
            class="review-input review-textarea"
            id="specificDeadlinesOrConstraints"
            name="specificDeadlinesOrConstraints"
            placeholder="I work asynchronously. If you have a critical emergency today, I might not be the right fit."
            rows="4"
          />
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-qualification">
          <ArrowLeft /> Back
        </button>
        <button
          type="submit"
          class="review-button review-button-primary"
          data-qualified-submit
        >
          Submit for review
          <ArrowRight />
        </button>
      </div>
    </section>
  </form>

  <section data-terminal-panel="qualified" class="review-terminal" hidden>
    <div class="review-step-head">
      <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 4</p>
      <h3 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl font-(family-name:--font-editorial-new)">
        Application Received Successfully
      </h3>
      <p class="review-step-copy">
        Thank you for taking the time to complete this application. I personally review every submission to understand the context behind each engineering challenge and determine how I can best help your team move forward with clarity and confidence.
      </p>
    </div>
    <div class="review-terminal-copy">
      <h3 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl font-(family-name:--font-editorial-new)">
        What happens next?
      </h3>
      <ol class="list-decimal list-inside text-zinc-300">
        <li><strong>Review:</strong> I will evaluate your technical context and the potential business impact within the next 48 hours.</li>
        <li><strong>Selection:</strong> To maintain the highest quality of delivery, I only accept a limited number of engagements each month, prioritizing projects where my diagnosis can unlock the most significant growth.</li>
        <li>
          <strong>Next Steps:</strong> If there is a strategic fit, you will receive an email with:
          <ul class="list-disc list-inside">
            <li>A secure <strong>payment link</strong> for the {usDollar.format(consultancyAmount)} audit fee.</li>
            <li>A <strong>Technical Onboarding Checklist</strong> with instructions on how to provide the necessary logs, metrics, and documentation for analysis.</li>
            <li>Following the receipt of the information, we will <strong>coordinate the next steps</strong> to initiate the diagnostic process.</li>
          </ul>
        </li>
      </ol>
    </div>
  </section>
</div>

<script
  define:vars={{
    sourcePath,
    webhookUrl,
    formSentCookieName,
    formSentCookieValue,
  }}
>
  class FormSubmissionError extends Error {
    constructor(message, statusCode, responseBody) {
      super(message);
      this.name = "FormSubmissionError";
      this.responseBody = responseBody;
      this.statusCode = statusCode;
    }
  }

  const initStrategicReviewForm = () => {
    const root = document.querySelector<HTMLDivElement>("[data-strategic-review-form]");

    if (!root || root.dataset.initialized === "true") {
      return;
    }

    const form = root.querySelector<HTMLFormElement>("[data-review-form]");
    const messageElement = root.querySelector<HTMLDivElement>("[data-form-message]");
    const contactPanel = root.querySelector<HTMLElement>('[data-step-panel="contact"]');
    const qualificationPanel = root.querySelector<HTMLElement>('[data-step-panel="qualification"]');
    const diagnosticPanel = root.querySelector<HTMLElement>('[data-step-panel="diagnostic"]');
    const qualifiedPanel = root.querySelector<HTMLElement>('[data-terminal-panel="qualified"]');
    const qualifiedSubmitButton = root.querySelector<HTMLButtonElement>("[data-qualified-submit]");
    const nextContactButton = root.querySelector<HTMLButtonElement>('[data-action="next-contact"]');
    const backContactButton = root.querySelector<HTMLButtonElement>('[data-action="back-contact"]');
    const nextQualificationButton = root.querySelector<HTMLButtonElement>('[data-action="next-qualification"]');
    const backQualificationButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-action="back-qualification"]'),
    );

    if (
      !form ||
      !messageElement ||
      !contactPanel ||
      !qualificationPanel ||
      !diagnosticPanel ||
      !qualifiedPanel ||
      !qualifiedSubmitButton ||
      !nextContactButton ||
      !backContactButton ||
      !nextQualificationButton ||
      backQualificationButtons.length === 0
    ) {
      throw new Error("Strategic review form is missing required elements.");
    }

    root.dataset.initialized = "true";

    const panelsByStep = {
      contact: contactPanel,
      diagnostic: diagnosticPanel,
      qualification: qualificationPanel,
    };
    const formName = "strategic_review";
    const stepNumbers = {
      contact: 1,
      qualification: 2,
      diagnostic: 3,
      qualified: 4,
    };

    const qualifiedSubmitLabel = qualifiedSubmitButton.innerHTML;

    const sendGtagEvent = (eventName, eventParams) => {
      if (typeof window.gtag !== "function") {
        return;
      }

      window.gtag("event", eventName, {
        form_name: formName,
        source_path: sourcePath,
        ...eventParams,
      });
    };

    const clearMessage = () => {
      messageElement.hidden = true;
      messageElement.textContent = "";
      messageElement.dataset.state = "";
    };

    const showErrorMessage = (message) => {
      messageElement.hidden = false;
      messageElement.textContent = message;
      messageElement.dataset.state = "error";
    };

    const showStep = (step) => {
      clearMessage();
      form.hidden = false;
      qualifiedPanel.hidden = true;

      Object.keys(panelsByStep).forEach((stepId) => {
        panelsByStep[stepId].hidden = stepId !== step;
      });

      sendGtagEvent("strategic_review_form_step_view", {
        page_path: window.location.pathname,
        step_name: step,
        step_number: stepNumbers[step],
      });
    };

    const showQualifiedTerminal = () => {
      clearMessage();
      form.hidden = true;
      qualifiedPanel.hidden = false;
      document.documentElement.dataset.strategicReviewFormSent = 'true';

      sendGtagEvent("strategic_review_form_step_view", {
        page_path: window.location.pathname,
        step_name: "qualified",
        step_number: stepNumbers.qualified,
      });
    };

    const scrollFormToTop = () => {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      requestAnimationFrame(() => {
        root.scrollIntoView({
          behavior: prefersReducedMotion ? "auto" : "smooth",
          block: "start",
        });
      });
    };

    const getPanelFields = (step) => {
      return Array.from(
        panelsByStep[step].querySelectorAll(
          "input, select, textarea",
        ),
      );
    };

    const validateStep = (step) => {
      const fields = getPanelFields(step);
      const invalidField = fields.find((field) => !field.checkValidity());

      if (!invalidField) {
        return true;
      }

      sendGtagEvent("strategic_review_form_validation_error", {
        field_name: invalidField.getAttribute("name") || "",
        page_path: window.location.pathname,
        step_name: step,
        step_number: stepNumbers[step],
      });
      invalidField.reportValidity();
      invalidField.focus();
      return false;
    };

    const readString = (formData, fieldName) => {
      const value = formData.get(fieldName);
      if (typeof value !== "string") {
        throw new Error(`Missing expected string value for ${fieldName}.`);
      }
      return value.trim();
    };

    const createQualifiedSubmission = (formData) => {
      return {
        companyWebsite: readString(formData, "companyWebsite"),
        fullName: readString(formData, "fullName"),
        linkedinProfile: readString(formData, "linkedinProfile"),
        role: readString(formData, "role"),
        workEmail: readString(formData, "workEmail"),
        currentTechStack: readString(formData, "currentTechStack"),
        estimatedBusinessImpact: readString(formData, "estimatedBusinessImpact"),
        primaryTechnicalBottleneck: readString(formData, "primaryTechnicalBottleneck"),
        specificDeadlinesOrConstraints: readString(formData, "specificDeadlinesOrConstraints"),
        engineeringTeamSize: readString(formData, "engineeringTeamSize"),
        implementationCapacity: readString(formData, "implementationCapacity"),
        submittedAt: new Date().toISOString(),
      };
    };

    const submitPayload = async (payload) => {
      const response = await fetch(webhookUrl, {
        body: JSON.stringify(payload),
        headers: {
          "Content-Type": "application/json",
        },
        method: "POST",
      });

      const responseBody = await response.text();

      if (!response.ok) {
        throw new FormSubmissionError(
          `Strategic review submission failed with status ${response.status}.`,
          response.status,
          responseBody,
        );
      }
    };

    const setButtonsDisabled = (isDisabled) => {
      qualifiedSubmitButton.disabled = isDisabled;
    };

    const setQualifiedSubmittingState = (isSubmitting) => {
      qualifiedSubmitButton.innerHTML = isSubmitting
        ? "Submitting..."
        : qualifiedSubmitLabel;
    };

    const createActionableErrorMessage = (error) => {
      if (error instanceof FormSubmissionError) {
        // const bodyPreview = error.responseBody.trim();
        // return `Unable to submit your application right now. Status ${error.statusCode}. Response: ${bodyPreview || "Empty response body."}`;
      }

      if (error instanceof Error) {
        // return `Unable to submit your application right now. ${error.message}`;
      }

      return "Unable to submit your application right now. Please try again in a few minutes.";
    };

    const moveFromContactToQualification = () => {
      if (!validateStep("contact")) {
        return;
      }

      sendGtagEvent("strategic_review_form_step_complete", {
        page_path: window.location.pathname,
        step_name: "contact",
        step_number: stepNumbers.contact,
      });
      showStep("qualification");
      scrollFormToTop();
    };

    const moveFromQualification = () => {
      if (!validateStep("qualification")) {
        return;
      }

      sendGtagEvent("strategic_review_form_step_complete", {
        page_path: window.location.pathname,
        step_name: "qualification",
        step_number: stepNumbers.qualification,
      });
      showStep("diagnostic");
      scrollFormToTop();
    };

    const submitQualifiedApplication = async () => {
      if (!validateStep("diagnostic")) {
        return;
      }

      clearMessage();
      setButtonsDisabled(true);
      setQualifiedSubmittingState(true);

      sendGtagEvent("strategic_review_form_submit_attempt", {
        page_path: window.location.pathname,
        step_name: "diagnostic",
        step_number: stepNumbers.diagnostic,
      });

      try {
        const payload = createQualifiedSubmission(new FormData(form));
        await submitPayload(payload);
        sendGtagEvent("strategic_review_form_step_complete", {
          page_path: window.location.pathname,
          step_name: "diagnostic",
          step_number: stepNumbers.diagnostic,
        });
        sendGtagEvent("strategic_review_form_submit_success", {
          page_path: window.location.pathname,
        });
        showQualifiedTerminal();
      } catch (error) {
        sendGtagEvent("strategic_review_form_submit_error", {
          error_name: error instanceof Error ? error.name : "UnknownError",
          page_path: window.location.pathname,
          status_code: error instanceof FormSubmissionError ? error.statusCode : "",
        });
        showErrorMessage(createActionableErrorMessage(error));
      } finally {
        setQualifiedSubmittingState(false);
        setButtonsDisabled(false);
      }
    };

    nextContactButton.addEventListener("click", moveFromContactToQualification);
    backContactButton.addEventListener("click", () => {
      showStep("contact");
    });
    nextQualificationButton.addEventListener("click", moveFromQualification);
    backQualificationButtons.forEach((button) => {
      button.addEventListener("click", () => {
        showStep("qualification");
      });
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitQualifiedApplication();
    });

    sendGtagEvent("strategic_review_form_step_view", {
      page_path: window.location.pathname,
      step_name: "contact",
      step_number: stepNumbers.contact,
    });
  };

  initStrategicReviewForm();
  document.addEventListener("astro:page-load", initStrategicReviewForm);
</script>

<style>
  .review-form-root {
    display: grid;
    gap: 1.5rem;
  }

  .review-form-message {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .review-form-message[data-state="error"] {
    border-color: rgb(248 113 113 / 0.28);
    background: rgb(127 29 29 / 0.18);
    color: rgb(254 202 202);
  }

  .review-form-message[data-state="success"] {
    border-color: rgb(253 186 116 / 0.3);
    background: rgb(253 186 116 / 0.12);
    color: rgb(255 237 213);
  }

  .review-step,
  .review-terminal {
    display: grid;
    gap: 2rem;
  }

  .review-step-head {
    display: grid;
    gap: 0.85rem;
  }

  .review-step-copy {
    margin: 0;
    color: rgb(212 212 216);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .review-compact-copy {
    color: rgb(161 161 170);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .review-field-group {
    display: grid;
    gap: 1.5rem;
  }

  .review-field,
  .review-fieldset {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .review-label {
    color: white;
    font-size: 1.05rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .review-required {
    color: rgb(253 186 116);
  }

  .review-help {
    color: rgb(161 161 170);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.7;
  }

  .review-input {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.5rem;
    background-color: rgb(255 255 255 / 0.04);
    color: white;
    font: inherit;
    /* min-height: 3.5rem; */
    padding: 0.6rem 1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .review-input::placeholder {
    color: rgb(113 113 122);
  }

  .review-input:hover {
    border-color: rgb(255 255 255 / 0.16);
  }

  .review-input:focus {
    outline: none;
    border-color: rgb(253 186 116 / 0.9);
    box-shadow: 0 0 0 0.2rem rgb(253 186 116 / 0.14);
    background-color: rgb(255 255 255 / 0.06);
  }

  .review-select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, rgb(161 161 170) 50%),
      linear-gradient(135deg, rgb(161 161 170) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) calc(50% + 2px),
      calc(100% - 0.95rem) calc(50% + 2px);
    background-repeat: no-repeat;
    background-size: 0.4rem 0.4rem;
    padding-right: 2.8rem;
  }

  .review-textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .review-choice-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .review-choice {
    display: inline-flex;
  }

  .review-choice-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .review-choice-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: rgb(228 228 231);
    cursor: pointer;
    font-size: 0.98rem;
    line-height: 1.45;
    padding: 0.8rem 1.1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .review-choice-input:focus-visible + .review-choice-label {
    outline: 2px solid rgb(253 186 116 / 0.75);
    outline-offset: 2px;
  }

  .review-choice-input:checked + .review-choice-label {
    border-color: rgb(253 186 116 / 0.78);
    background: rgb(253 186 116 / 0.14);
