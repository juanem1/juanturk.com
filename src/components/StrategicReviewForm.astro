---
interface Props {
  readonly webhookUrl: string;
}

type ReviewSubmissionPath = "qualified" | "not_fit";

interface ContactStepData {
  readonly companyWebsite: string;
  readonly fullName: string;
  readonly linkedinProfile: string;
  readonly role: string;
  readonly workEmail: string;
}

interface QualificationStepData {
  readonly auditInvestment: string;
  readonly engineeringTeamSize: string;
  readonly implementationCapacity: string;
}

interface DiagnosticStepData {
  readonly currentTechStack: string;
  readonly estimatedBusinessImpact: string;
  readonly primaryTechnicalBottleneck: string;
  readonly specificDeadlinesOrConstraints: string;
}

interface StrategicReviewSubmission {
  readonly contact: ContactStepData;
  readonly diagnostic: DiagnosticStepData | null;
  readonly qualification: QualificationStepData;
  readonly sourcePath: "/strategic-technical-review";
  readonly submissionPath: ReviewSubmissionPath;
  readonly submittedAt: string;
}

interface ChoiceOption {
  readonly label: string;
  readonly value: string;
}

const { webhookUrl }: Props = Astro.props;

const sourcePath = "/strategic-technical-review" as const;
const roleOptions: readonly ChoiceOption[] = [
  { label: "Founder / CEO", value: "Founder / CEO" },
  { label: "CTO / VP of Engineering", value: "CTO / VP of Engineering" },
  { label: "Product Lead", value: "Product Lead" },
  { label: "Other", value: "Other" },
];
const engineeringTeamSizeOptions: readonly ChoiceOption[] = [
  { label: "1-5 engineers", value: "1-5 engineers" },
  { label: "5-10 engineers", value: "5-10 engineers" },
  { label: "10-15 engineers", value: "10-15 engineers" },
  { label: "15+ engineers", value: "15+ engineers" },
  { label: "We don't have a dev team yet", value: "We don't have a dev team yet" },
];
const implementationCapacityOptions: readonly ChoiceOption[] = [
  { label: "Yes, we are ready to execute", value: "Yes, we are ready to execute" },
  {
    label: "No, we are looking for someone to code the solution",
    value: "No, we are looking for someone to code the solution",
  },
];
const auditInvestmentOptions: readonly ChoiceOption[] = [
  {
    label: "Yes, we have an approved budget and are ready to start",
    value: "Yes, we have an approved budget and are ready to start",
  },
  { label: "I am still evaluating options", value: "I am still evaluating options" },
];
---

<div data-strategic-review-form class="review-form-root">
  <div class="review-form-message" data-form-message role="status" aria-live="polite" hidden />

  <form data-review-form class="review-form">
    <section data-step-panel="contact" class="review-step">
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 1 - User information</p>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="fullName">
          <span class="review-label">Full name <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="fullName"
            name="fullName"
            type="text"
            autocomplete="name"
            required
          />
        </label>

        <label class="review-field" for="workEmail">
          <span class="review-label">Email <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="workEmail"
            name="workEmail"
            type="email"
            autocomplete="email"
            placeholder="Where I should send the next steps"
            required
          />
          <!-- <span class="review-help">Where I should send the diagnostic, results and next steps.</span> -->
        </label>

        <label class="review-field" for="companyWebsite">
          <span class="review-label">Company website <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="companyWebsite"
            name="companyWebsite"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="I'll use this to research your product before our call"
            required
          />
          <!-- <span class="review-help">I'll use this to research your product before our call</span> -->
        </label>

        <label class="review-field" for="linkedinProfile">
          <span class="review-label">LinkedIn profile <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="linkedinProfile"
            name="linkedinProfile"
            type="url"
            inputmode="url"
            autocomplete="url"
            required
          />
        </label>

        <label class="review-field" for="role">
          <span class="review-label">Your role <span class="review-required">*</span></span>
          <select class="review-input review-select" id="role" name="role" required>
            <option value="">Select your role</option>
            {roleOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-primary" data-action="next-contact">
          Proceed to qualification
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>

    <section data-step-panel="qualification" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 2</p>
        <h3 class="mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Team &amp; Implementation</h3>
        <p class="review-step-copy">
          Before we dive into the technical details, let&apos;s ensure our operational requirements
          are aligned for a successful engagement.
        </p>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="engineeringTeamSize">
          <span class="review-label">Engineering team size <span class="review-required">*</span></span>
          <select
            class="review-input review-select"
            id="engineeringTeamSize"
            name="engineeringTeamSize"
            required
          >
            <option value="">Select your team size</option>
            {engineeringTeamSizeOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <fieldset class="review-field review-fieldset">
          <legend class="review-label">Implementation capacity <span class="review-required">*</span></legend>
          <p class="review-step-copy review-compact-copy">
            Do you have a dedicated team ready to implement the recommended roadmap?
          </p>
          <div class="review-choice-grid">
            {implementationCapacityOptions.map((option) => (
              <label class="review-choice">
                <input
                  class="review-choice-input"
                  type="radio"
                  name="implementationCapacity"
                  value={option.value}
                  required
                />
                <span class="review-choice-label">{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="review-field review-fieldset">
          <legend class="review-label">Audit investment <span class="review-required">*</span></legend>
          <p class="review-step-copy review-compact-copy">
            The fixed investment for this high-level Audit &amp; Roadmap is $2,000 USD
          </p>
          <div class="review-choice-grid">
            {auditInvestmentOptions.map((option) => (
              <label class="review-choice">
                <input
                  class="review-choice-input"
                  type="radio"
                  name="auditInvestment"
                  value={option.value}
                  required
                />
                <span class="review-choice-label">{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-contact">
          Back
        </button>
        <button type="button" class="review-button review-button-primary" data-action="next-qualification">
          Continue to technical diagnostic
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>

    <section data-step-panel="diagnostic" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 3</p>
        <h3 class="mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Diagnostic Focus</h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="primaryTechnicalBottleneck">
          <span class="review-label">
            What is the primary technical bottleneck you need to solve? <span class="review-required">*</span>
          </span>
          <span class="review-step-copy review-compact-copy">
            Please provide specific context, describe where the friction is (e.g. &quot;Our API
            response time spikes to 5s during peak hours&quot; or &quot;Our CI/CD pipeline is so brittle that
            we&apos;ve stopped deploying on Fridays&quot;).
          </span>
          <textarea
            class="review-input review-textarea"
            id="primaryTechnicalBottleneck"
            name="primaryTechnicalBottleneck"
            placeholder="Provide a brief summary of the symptoms and what you've tried so far to fix it"
            required
            rows="5"
          />
        </label>

        <label class="review-field" for="estimatedBusinessImpact">
          <span class="review-label">Estimated business impact <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Help me quantify the cost of inaction. If this issue persists, how many engineering
            hours are wasted per week? Are you losing customers due to performance, or is a major
            launch blocked?
          </span>
          <textarea
            class="review-input review-textarea"
            id="estimatedBusinessImpact"
            name="estimatedBusinessImpact"
            placeholder="We estimate 20% of our dev time is spent on manual hotfixes, or Slow checkout is causing a measurable 15% drop in conversion."
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="currentTechStack">
          <span class="review-label">Current tech stack <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            List your core technologies and infrastructure setup.
          </span>
          <textarea
            class="review-input review-textarea"
            id="currentTechStack"
            name="currentTechStack"
            placeholder="High-level languages, Cloud provider, database, monitoring, etc"
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="specificDeadlinesOrConstraints">
          <span class="review-label">Specific deadlines or constraints</span>
          <span class="review-step-copy review-compact-copy">
            Please note I work asynchronously on a specific schedule.
          </span>
          <textarea
            class="review-input review-textarea"
            id="specificDeadlinesOrConstraints"
            name="specificDeadlinesOrConstraints"
            placeholder="I work asynchronously. If you have a critical emergency today, I might not be the right fit."
            rows="4"
          />
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-qualification">
          Back
        </button>
        <button
          type="submit"
          class="review-button review-button-primary"
          data-qualified-submit
        >
          Submit application for review
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>
  </form>

  <section data-terminal-panel="qualified" class="review-terminal" hidden>
    <div class="review-step-head">
      <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 4</p>
      <h3 class="mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Application Received Successfully</h3>
      <p class="review-step-copy">
        Thank you for providing these details. I personally review every application to ensure
        that my expertise in high-scale architectural standards and engineering efficiency can
        deliver the maximum strategic value for your organization.
      </p>
    </div>

    <div class="review-terminal-copy">
      <h4 class="review-terminal-heading">What happens next?</h4>
      <p><strong>1. Review:</strong> I will evaluate your technical context and the potential business impact within the next 48 hours.</p>
      <p><strong>2. Selection:</strong> To maintain the highest quality of delivery, I only accept a limited number of engagements each month, prioritizing projects where my diagnosis can unlock the most significant growth.</p>
      <p>
        <strong>3. Next Steps:</strong> If there is a strategic fit, you will receive an email with:
      </p>
      <p>- A secure <strong>payment link</strong> for the $2,000 USD audit fee.</p>
      <p>- A <strong>Technical Onboarding Checklist</strong> with instructions on how to provide the necessary logs, metrics, and documentation for analysis.</p>
      <p>- Following the receipt of the information, we will <strong>coordinate the next steps</strong> to initiate the diagnostic process.</p>
    </div>
  </section>

  <section data-terminal-panel="not_fit" class="review-terminal" hidden>
    <div class="review-step-head">
      <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 5</p>
      <h3 class="mt-3 text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">Strategic Guidance</h3>
      <h4 class="review-terminal-heading">Ensuring the right fit for your stage</h4>
      <p class="review-step-copy">
        Thank you for your interest. Based on the information provided, it appears your current
        needs lean more toward <strong>initial development and execution</strong> rather than a
        architectural diagnostic.
      </p>
      <p class="review-step-copy">
        My audit framework is specifically designed for organizations with
        <strong> established engineering teams</strong> looking to optimize for scale, stability,
        and delivery speed.
      </p>
      <p class="review-step-copy">
        <strong>My recommendation for you:</strong><br />
        At this stage, your resources are best invested in building your core team / executing
        your current roadmap. Once you have a foundation ready for scaling, I would be happy to
        review a new application.
      </p>
    </div>

    <div class="review-actions">
      <button type="button" class="review-button review-button-primary" data-not-fit-submit>
        Submit
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </section>
</div>

<script
  define:vars={{
    nonFitEngineeringTeamSizeValue: "We don't have a dev team yet",
    nonFitImplementationValue: "No, we are looking for someone to code the solution",
    nonFitInvestmentValue: "I am still evaluating options",
    sourcePath,
    webhookUrl,
  }}
>
  class FormSubmissionError extends Error {
    constructor(message, statusCode, responseBody) {
      super(message);
      this.name = "FormSubmissionError";
      this.responseBody = responseBody;
      this.statusCode = statusCode;
    }
  }

  const initStrategicReviewForm = () => {
    const root = document.querySelector("[data-strategic-review-form]");

    if (!root || root.dataset.initialized === "true") {
      return;
    }

    const form = root.querySelector("[data-review-form]");
    const messageElement = root.querySelector("[data-form-message]");
    const contactPanel = root.querySelector('[data-step-panel="contact"]');
    const qualificationPanel = root.querySelector('[data-step-panel="qualification"]');
    const diagnosticPanel = root.querySelector('[data-step-panel="diagnostic"]');
    const qualifiedPanel = root.querySelector('[data-terminal-panel="qualified"]');
    const notFitPanel = root.querySelector('[data-terminal-panel="not_fit"]');
    const qualifiedSubmitButton = root.querySelector("[data-qualified-submit]");
    const notFitSubmitButton = root.querySelector("[data-not-fit-submit]");
    const nextContactButton = root.querySelector('[data-action="next-contact"]');
    const backContactButton = root.querySelector('[data-action="back-contact"]');
    const nextQualificationButton = root.querySelector('[data-action="next-qualification"]');
    const backQualificationButton = root.querySelector('[data-action="back-qualification"]');

    if (
      !form ||
      !messageElement ||
      !contactPanel ||
      !qualificationPanel ||
      !diagnosticPanel ||
      !qualifiedPanel ||
      !notFitPanel ||
      !qualifiedSubmitButton ||
      !notFitSubmitButton ||
      !nextContactButton ||
      !backContactButton ||
      !nextQualificationButton ||
      !backQualificationButton
    ) {
      throw new Error("Strategic review form is missing required elements.");
    }

    root.dataset.initialized = "true";

    const panelsByStep = {
      contact: contactPanel,
      diagnostic: diagnosticPanel,
      qualification: qualificationPanel,
    };

    const qualifiedSubmitLabel = qualifiedSubmitButton.innerHTML;
    const notFitSubmitLabel = notFitSubmitButton.innerHTML;

    const clearMessage = () => {
      messageElement.hidden = true;
      messageElement.textContent = "";
      messageElement.dataset.state = "";
    };

    const showErrorMessage = (message) => {
      messageElement.hidden = false;
      messageElement.textContent = message;
      messageElement.dataset.state = "error";
    };

    const showSuccessMessage = (message) => {
      messageElement.hidden = false;
      messageElement.textContent = message;
      messageElement.dataset.state = "success";
    };

    const showStep = (step) => {
      clearMessage();
      form.hidden = false;
      qualifiedPanel.hidden = true;
      notFitPanel.hidden = true;

      Object.keys(panelsByStep).forEach((stepId) => {
        panelsByStep[stepId].hidden = stepId !== step;
      });
    };

    const showQualifiedTerminal = () => {
      clearMessage();
      form.hidden = true;
      qualifiedPanel.hidden = false;
      notFitPanel.hidden = true;
    };

    const showNotFitTerminal = () => {
      clearMessage();
      form.hidden = true;
      qualifiedPanel.hidden = true;
      notFitPanel.hidden = false;
    };

    const getPanelFields = (step) => {
      return Array.from(
        panelsByStep[step].querySelectorAll("input, select, textarea"),
      );
    };

    const validateStep = (step) => {
      const fields = getPanelFields(step);
      const invalidField = fields.find((field) => !field.checkValidity());

      if (!invalidField) {
        return true;
      }

      invalidField.reportValidity();
      invalidField.focus();
      return false;
    };

    const readString = (formData, fieldName) => {
      const value = formData.get(fieldName);

      if (typeof value !== "string") {
        throw new Error(`Missing expected string value for ${fieldName}.`);
      }

      return value.trim();
    };

    const createContactStepData = (formData) => {
      return {
        companyWebsite: readString(formData, "companyWebsite"),
        fullName: readString(formData, "fullName"),
        linkedinProfile: readString(formData, "linkedinProfile"),
        role: readString(formData, "role"),
        workEmail: readString(formData, "workEmail"),
      };
    };

    const createQualificationStepData = (formData) => {
      return {
        auditInvestment: readString(formData, "auditInvestment"),
        engineeringTeamSize: readString(formData, "engineeringTeamSize"),
        implementationCapacity: readString(formData, "implementationCapacity"),
      };
    };

    const createDiagnosticStepData = (formData) => {
      return {
        currentTechStack: readString(formData, "currentTechStack"),
        estimatedBusinessImpact: readString(formData, "estimatedBusinessImpact"),
        primaryTechnicalBottleneck: readString(formData, "primaryTechnicalBottleneck"),
        specificDeadlinesOrConstraints: readString(formData, "specificDeadlinesOrConstraints"),
      };
    };

    const createQualifiedSubmission = (formData) => {
      return {
        contact: createContactStepData(formData),
        diagnostic: createDiagnosticStepData(formData),
        qualification: createQualificationStepData(formData),
        sourcePath,
        submissionPath: "qualified",
        submittedAt: new Date().toISOString(),
      };
    };

    const createNotFitSubmission = (formData) => {
      return {
        contact: createContactStepData(formData),
        diagnostic: null,
        qualification: createQualificationStepData(formData),
        sourcePath,
        submissionPath: "not_fit",
        submittedAt: new Date().toISOString(),
      };
    };

    const isNotFitQualification = (qualification) => {
      return (
        qualification.engineeringTeamSize === nonFitEngineeringTeamSizeValue ||
        qualification.implementationCapacity === nonFitImplementationValue ||
        qualification.auditInvestment === nonFitInvestmentValue
      );
    };

    const submitPayload = async (payload) => {
      const response = await fetch(webhookUrl, {
        body: JSON.stringify(payload),
        headers: {
          "Content-Type": "application/json",
        },
        method: "POST",
      });

      const responseBody = await response.text();

      if (!response.ok) {
        throw new FormSubmissionError(
          `Strategic review submission failed with status ${response.status}.`,
          response.status,
          responseBody,
        );
      }
    };

    const setButtonsDisabled = (isDisabled) => {
      qualifiedSubmitButton.disabled = isDisabled;
      notFitSubmitButton.disabled = isDisabled;
    };

    const setQualifiedSubmittingState = (isSubmitting) => {
      qualifiedSubmitButton.innerHTML = isSubmitting
        ? "Submitting..."
        : qualifiedSubmitLabel;
    };

    const setNotFitSubmittingState = (isSubmitting) => {
      notFitSubmitButton.innerHTML = isSubmitting ? "Submitting..." : notFitSubmitLabel;
    };

    const createActionableErrorMessage = (error) => {
      if (error instanceof FormSubmissionError) {
        const bodyPreview = error.responseBody.trim();
        return `Unable to submit your application right now. Status ${error.statusCode}. Response: ${bodyPreview || "Empty response body."}`;
      }

      if (error instanceof Error) {
        return `Unable to submit your application right now. ${error.message}`;
      }

      return "Unable to submit your application right now due to an unknown error.";
    };

    const moveFromContactToQualification = () => {
      if (!validateStep("contact")) {
        return;
      }

      showStep("qualification");
    };

    const moveFromQualification = () => {
      if (!validateStep("qualification")) {
        return;
      }

      const qualification = createQualificationStepData(new FormData(form));

      if (isNotFitQualification(qualification)) {
        showNotFitTerminal();
        return;
      }

      showStep("diagnostic");
    };

    const submitQualifiedApplication = async () => {
      if (!validateStep("diagnostic")) {
        return;
      }

      clearMessage();
      setButtonsDisabled(true);
      setQualifiedSubmittingState(true);

      try {
        const payload = createQualifiedSubmission(new FormData(form));
        await submitPayload(payload);
        showQualifiedTerminal();
      } catch (error) {
        showErrorMessage(createActionableErrorMessage(error));
      } finally {
        setQualifiedSubmittingState(false);
        setButtonsDisabled(false);
      }
    };

    const submitNotFitApplication = async () => {
      clearMessage();
      setButtonsDisabled(true);
      setNotFitSubmittingState(true);

      try {
        const payload = createNotFitSubmission(new FormData(form));
        await submitPayload(payload);
        showSuccessMessage("Thank you. Your response has been recorded.");
        notFitSubmitButton.hidden = true;
      } catch (error) {
        showErrorMessage(createActionableErrorMessage(error));
      } finally {
        setNotFitSubmittingState(false);
        setButtonsDisabled(false);
      }
    };

    nextContactButton.addEventListener("click", moveFromContactToQualification);
    backContactButton.addEventListener("click", () => {
      showStep("contact");
    });
    nextQualificationButton.addEventListener("click", moveFromQualification);
    backQualificationButton.addEventListener("click", () => {
      showStep("qualification");
    });
    notFitSubmitButton.addEventListener("click", () => {
      void submitNotFitApplication();
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitQualifiedApplication();
    });
  };

  initStrategicReviewForm();
  document.addEventListener("astro:page-load", initStrategicReviewForm);
</script>

<style>
  .review-form-root {
    display: grid;
    gap: 1.5rem;
  }

  .review-form-message {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .review-form-message[data-state="error"] {
    border-color: rgb(248 113 113 / 0.28);
    background: rgb(127 29 29 / 0.18);
    color: rgb(254 202 202);
  }

  .review-form-message[data-state="success"] {
    border-color: rgb(253 186 116 / 0.3);
    background: rgb(253 186 116 / 0.12);
    color: rgb(255 237 213);
  }

  .review-step,
  .review-terminal {
    display: grid;
    gap: 2rem;
  }

  .review-step-head {
    display: grid;
    gap: 0.85rem;
  }

  .review-step-copy {
    margin: 0;
    color: rgb(212 212 216);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .review-compact-copy {
    color: rgb(161 161 170);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .review-field-group {
    display: grid;
    gap: 1.5rem;
  }

  .review-field,
  .review-fieldset {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .review-label {
    color: white;
    font-size: 1.05rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .review-required {
    color: rgb(253 186 116);
  }

  .review-help {
    color: rgb(161 161 170);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.7;
  }

  .review-input {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.04);
    color: white;
    font: inherit;
    /* min-height: 3.5rem; */
    padding: 0.6rem 1rem;
    transition:
      border-color 180ms ease,
