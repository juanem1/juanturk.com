---
import type { CollectionEntry } from "astro:content";
import { ArrowLeft, ArrowRight } from '@lucide/astro';

interface Props {
  previous: CollectionEntry<"posts"> | null;
  next: CollectionEntry<"posts"> | null;
}

const { previous, next }: Props = Astro.props;
---

{(previous || next) && (
  <nav aria-label="Post navigation" class="border-t border-white/10 pt-8">
    <div class="grid gap-3 sm:auto-rows-fr sm:grid-cols-2">
      <div class="min-w-0 sm:h-full">
        {previous && (
          <a
            href={`/blog/${previous.id}/`}
            class="flex min-h-16 w-full flex-col items-start justify-center rounded-lg border border-white/25 px-5 py-4 text-left text-white transition hover:border-white hover:no-underline sm:h-full"
          >
            <span class="flex items-center text-zinc-400">
              <ArrowLeft class="mr-2" />
              <span class="text-xs font-semibold uppercase tracking-tight">Previous</span>
            </span>
            <span class="mt-2 text-base font-semibold leading-tight text-white">{previous.data.title}</span>
          </a>
        )}
      </div>

      <div class="min-w-0 sm:h-full">
        {next && (
          <a
            href={`/blog/${next.id}/`}
            class="flex min-h-16 w-full flex-col items-start justify-center rounded-lg border border-white/25 px-5 py-4 text-right text-white transition hover:border-white hover:no-underline sm:h-full sm:items-end"
          >
            <span class="ml-auto flex items-center text-zinc-400">
              <span class="text-xs font-semibold uppercase tracking-tight">Next</span>
              <ArrowRight class="ml-2" />
            </span>
            <span class="mt-2 text-base font-semibold leading-tight text-white">{next.data.title}</span>
          </a>
        )}
      </div>
    </div>
  </nav>
)}
