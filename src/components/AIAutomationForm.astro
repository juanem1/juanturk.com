---
import { ArrowRight, ArrowLeft } from '@lucide/astro';

interface Props {
  readonly sourcePath: string;
  readonly webhookUrl: string;
}

interface ChoiceOption {
  readonly label: string;
  readonly value: string;
}

const { sourcePath, webhookUrl }: Props = Astro.props;
const skipSubmitForTesting = import.meta.env.PUBLIC_SKIP_SUBMIT_FOR_TESTING;

const roleOptions: readonly ChoiceOption[] = [
  { label: "COO / Head of Operations", value: "COO / Head of Operations" },
  { label: "CFO / Head of Finance", value: "CFO / Head of Finance" },
  { label: "Owner / CEO", value: "Owner / CEO" },
  { label: "Operations Manager", value: "Operations Manager" },
  { label: "Other", value: "Other" },
];
const companySizeOptions: readonly ChoiceOption[] = [
  { label: "Under 50 employees", value: "Under 50 employees" },
  { label: "50-150 employees", value: "50-150 employees" },
  { label: "150-300 employees", value: "150-300 employees" },
  { label: "300-500 employees", value: "300-500 employees" },
  { label: "500+ employees", value: "500+ employees" },
];
const industryOptions: readonly ChoiceOption[] = [
  { label: "Logistics", value: "Logistics" },
  { label: "Finance", value: "Finance" },
  { label: "Legal", value: "Legal" },
  { label: "Manufacturing", value: "Manufacturing" },
  { label: "Other", value: "Other" },
];
const internalTechCapacityOptions: readonly ChoiceOption[] = [
  { label: "Yes, we have an in-house tech team", value: "Yes, we have an in-house tech team" },
  {
    label: "Partially, a few technical people but no dedicated team",
    value: "Partially, a few technical people but no dedicated team",
  },
  { label: "No internal tech talent", value: "No internal tech talent" },
];
---

<div data-ai-automation-form class="review-form-root">
  <div class="review-form-message" data-form-message role="status" aria-live="polite" hidden />

  <form data-review-form class="review-form">
    <section data-step-panel="contact" class="review-step">
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 1 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
          Business information
        </h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="fullName">
          <span class="review-label">Full name <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="fullName"
            name="fullName"
            type="text"
            autocomplete="name"
            required
          />
        </label>

        <label class="review-field" for="workEmail">
          <span class="review-label">Email <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="workEmail"
            name="workEmail"
            type="email"
            autocomplete="email"
            placeholder="Where I should send the next steps"
            required
          />
        </label>

        <label class="review-field" for="companyWebsite">
          <span class="review-label">Company website <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="companyWebsite"
            name="companyWebsite"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="I'll use this to understand your business before our session"
            required
          />
        </label>

        <label class="review-field" for="linkedinProfile">
          <span class="review-label">LinkedIn profile <span class="review-required">*</span></span>
          <input
            class="review-input"
            id="linkedinProfile"
            name="linkedinProfile"
            type="url"
            inputmode="url"
            autocomplete="url"
            required
          />
        </label>

        <label class="review-field" for="role">
          <span class="review-label">Your role <span class="review-required">*</span></span>
          <select class="review-input review-select" id="role" name="role" required>
            <option value="">Select your role</option>
            {roleOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-primary" data-action="next-contact">
          Continue
          <ArrowRight />
        </button>
      </div>
    </section>

    <section data-step-panel="qualification" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 2 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">Fit & readiness</h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="companySize">
          <span class="review-label">Company size <span class="review-required">*</span></span>
          <select
            class="review-input review-select"
            id="companySize"
            name="companySize"
            required
          >
            <option value="">Select your company size</option>
            {companySizeOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <label class="review-field" for="industry">
          <span class="review-label">Industry <span class="review-required">*</span></span>
          <select
            class="review-input review-select"
            id="industry"
            name="industry"
            required
          >
            <option value="">Select your industry</option>
            {industryOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <label class="review-field" for="internalTechCapacity">
          <span class="review-label">Internal tech capacity <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Do you have internal technical talent to build and maintain automations today?
          </span>
          <select
            class="review-input review-select"
            id="internalTechCapacity"
            name="internalTechCapacity"
            required
          >
            <option value="">Select your internal tech capacity</option>
            {internalTechCapacityOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-contact">
          <ArrowLeft /> Back
        </button>
        <button type="button" class="review-button review-button-primary" data-action="next-qualification">
          Continue to operational details
          <ArrowRight />
        </button>
      </div>
    </section>

    <section data-step-panel="diagnostic" class="review-step" hidden>
      <div class="review-step-head">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 3 of 3</p>
        <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">Operational diagnostic</h3>
      </div>

      <div class="review-field-group">
        <label class="review-field" for="primaryOperationalBottleneck">
          <span class="review-label">
            What is the primary operational bottleneck you need to solve? <span class="review-required">*</span>
          </span>
          <span class="review-step-copy review-compact-copy">
            Describe the manual, repetitive process that is slowing your team down (e.g. &quot;Our
            team re-types invoice data from email into our ERP by hand every day&quot;).
          </span>
          <textarea
            class="review-input review-textarea"
            id="primaryOperationalBottleneck"
            name="primaryOperationalBottleneck"
            placeholder="Describe the process, who runs it, and where the friction is"
            required
            rows="5"
          />
        </label>

        <label class="review-field" for="repetitiveTaskVolume">
          <span class="review-label">Task volume & frequency <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Help me size the opportunity. How often does this happen, and how much staff time does
            it consume?
          </span>
          <textarea
            class="review-input review-textarea"
            id="repetitiveTaskVolume"
            name="repetitiveTaskVolume"
            placeholder="e.g. 3 people spend ~4 hours/day on this, around 800 records processed per week"
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="currentSystemsAndTools">
          <span class="review-label">Current systems & tools <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            List the core software and systems involved in this process so I can map the integration.
          </span>
          <textarea
            class="review-input review-textarea"
            id="currentSystemsAndTools"
            name="currentSystemsAndTools"
            placeholder="ERP, CRM, spreadsheets, email, internal databases, etc."
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="estimatedBusinessImpact">
          <span class="review-label">Estimated business impact <span class="review-required">*</span></span>
          <span class="review-step-copy review-compact-copy">
            Help me quantify the cost of inaction. What does this bottleneck cost you in wasted
            hours, errors, delays, or lost revenue?
          </span>
          <textarea
            class="review-input review-textarea"
            id="estimatedBusinessImpact"
            name="estimatedBusinessImpact"
            placeholder="e.g. ~60 staff hours/week lost, plus costly errors that require manual rework"
            required
            rows="4"
          />
        </label>

        <label class="review-field" for="timelineOrConstraints">
          <span class="review-label">Timeline or constraints</span>
          <span class="review-step-copy review-compact-copy">
            Any deadlines, compliance requirements, or constraints I should be aware of.
          </span>
          <textarea
            class="review-input review-textarea"
            id="timelineOrConstraints"
            name="timelineOrConstraints"
            placeholder="e.g. We need this addressed before our Q4 peak season, data cannot leave the EU"
            rows="4"
          />
        </label>
      </div>

      <div class="review-actions">
        <button type="button" class="review-button review-button-secondary" data-action="back-qualification">
          <ArrowLeft /> Back
        </button>
        <button
          type="submit"
          class="review-button review-button-primary"
          data-qualified-submit
        >
          Submit for review
          <ArrowRight />
        </button>
      </div>
    </section>
  </form>

  <section data-terminal-panel="qualified" class="review-terminal" hidden>
    <div class="review-step-head">
      <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Confirmation</p>
      <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
        Application received
      </h3>
      <p class="review-step-copy">
        Thank you for taking the time to complete this application. I personally review every submission to understand the operational reality behind each bottleneck and determine how AI and automation can deliver a measurable return for your business.
      </p>
    </div>
    <div class="review-terminal-copy">
      <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
        What happens next?
      </h3>
      <ol class="list-decimal list-inside text-zinc-300">
        <li><strong>Review:</strong> I will evaluate your operational context and the potential business impact within the next 48 hours.</li>
        <li><strong>Selection:</strong> To maintain the highest quality of delivery, I only accept a limited number of engagements each month, prioritizing projects where automation can unlock the most significant ROI.</li>
        <li>
          <strong>Next Steps:</strong> If there is a strategic fit, you will receive an email with:
          <ul class="list-disc list-inside">
            <li>A secure payment link</li>
            <li>An <strong>Operational Onboarding Checklist</strong> with instructions on how to share the process details, volumetry, and system access needed for the diagnosis.</li>
            <li>Once I have the information, we will <strong>coordinate the next steps</strong> to kick off the operational diagnostic.</li>
          </ul>
        </li>
      </ol>
    </div>
  </section>
</div>

<script
  define:vars={{
    sourcePath,
    webhookUrl,
    skipSubmitForTesting,
  }}
>
  class FormSubmissionError extends Error {
    constructor(message, statusCode, responseBody) {
      super(message);
      this.name = "FormSubmissionError";
      this.responseBody = responseBody;
      this.statusCode = statusCode;
    }
  }

  const getRequiredElement = (parent, selector, ElementType) => {
    const element = parent.querySelector(selector);

    if (!(element instanceof ElementType)) {
      throw new Error(`AI automation form is missing required element: ${selector}`);
    }

    return element;
  };

  const getRequiredElements = (parent, selector, ElementType) => {
    const elements = Array.from(parent.querySelectorAll(selector)).filter((element) => {
      return element instanceof ElementType;
    });

    if (elements.length === 0) {
      throw new Error(`AI automation form is missing required elements: ${selector}`);
    }

    return elements;
  };

  const initAIAutomationForm = () => {
    const root = document.querySelector("[data-ai-automation-form]");

    if (!(root instanceof HTMLDivElement) || root.dataset.initialized === "true") {
      return;
    }

    const form = getRequiredElement(root, "[data-review-form]", HTMLFormElement);
    const messageElement = getRequiredElement(root, "[data-form-message]", HTMLDivElement);
    const contactPanel = getRequiredElement(root, '[data-step-panel="contact"]', HTMLElement);
    const qualificationPanel = getRequiredElement(root, '[data-step-panel="qualification"]', HTMLElement);
    const diagnosticPanel = getRequiredElement(root, '[data-step-panel="diagnostic"]', HTMLElement);
    const qualifiedPanel = getRequiredElement(root, '[data-terminal-panel="qualified"]', HTMLElement);
    const qualifiedSubmitButton = getRequiredElement(root, "[data-qualified-submit]", HTMLButtonElement);
    const nextContactButton = getRequiredElement(root, '[data-action="next-contact"]', HTMLButtonElement);
    const backContactButton = getRequiredElement(root, '[data-action="back-contact"]', HTMLButtonElement);
    const nextQualificationButton = getRequiredElement(root, '[data-action="next-qualification"]', HTMLButtonElement);
    const backQualificationButtons = getRequiredElements(
      root,
      '[data-action="back-qualification"]',
      HTMLButtonElement,
    );

    root.dataset.initialized = "true";

    const panelsByStep = {
      contact: contactPanel,
      diagnostic: diagnosticPanel,
      qualification: qualificationPanel,
    };
    const formName = "ai_automation";
    const stepNumbers = {
      contact: 1,
      qualification: 2,
      diagnostic: 3,
      qualified: 4,
    };

    const qualifiedSubmitLabel = qualifiedSubmitButton.innerHTML;

    const triggerSubmit = () => {
      if (skipSubmitForTesting && skipSubmitForTesting === "true") {
        return false;
      }
      return true;
    };

    const sendGtagEvent = (eventName, eventParams) => {
      if (typeof window.gtag !== "function") {
        return;
      }

      window.gtag("event", eventName, {
        form_name: formName,
        source_path: sourcePath,
        ...eventParams,
      });
    };

    const clearMessage = () => {
      messageElement.hidden = true;
      messageElement.textContent = "";
      messageElement.dataset.state = "";
    };

    const showErrorMessage = (message) => {
      messageElement.hidden = false;
      messageElement.textContent = message;
      messageElement.dataset.state = "error";
    };

    const showStep = (step) => {
      clearMessage();
      form.hidden = false;
      qualifiedPanel.hidden = true;

      Object.keys(panelsByStep).forEach((stepId) => {
        panelsByStep[stepId].hidden = stepId !== step;
      });

      sendGtagEvent("ai_automation_form_step_view", {
        page_path: window.location.pathname,
        step_name: step,
        step_number: stepNumbers[step],
      });
    };

    const showQualifiedTerminal = () => {
      clearMessage();
      form.hidden = true;
      qualifiedPanel.hidden = false;
      document.documentElement.dataset.aiAutomationFormSent = 'true';

      sendGtagEvent("ai_automation_form_step_view", {
        page_path: window.location.pathname,
        step_name: "qualified",
        step_number: stepNumbers.qualified,
      });
    };

    const scrollFormToTop = () => {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      requestAnimationFrame(() => {
        root.scrollIntoView({
          behavior: prefersReducedMotion ? "auto" : "smooth",
          block: "start",
        });
      });
    };

    const getPanelFields = (step) => {
      return Array.from(
        panelsByStep[step].querySelectorAll(
          "input, select, textarea",
        ),
      );
    };

    const validateStep = (step) => {
      const fields = getPanelFields(step);
      const invalidField = fields.find((field) => !field.checkValidity());

      if (!invalidField) {
        return true;
      }

      sendGtagEvent("ai_automation_form_validation_error", {
        field_name: invalidField.getAttribute("name") || "",
        page_path: window.location.pathname,
        step_name: step,
        step_number: stepNumbers[step],
      });
      invalidField.reportValidity();
      invalidField.focus();
      return false;
    };

    const readString = (formData, fieldName) => {
      const value = formData.get(fieldName);
      if (typeof value !== "string") {
        throw new Error(`Missing expected string value for ${fieldName}.`);
      }
      return value.trim();
    };

    const createQualifiedSubmission = (formData) => {
      return {
        companyWebsite: readString(formData, "companyWebsite"),
        fullName: readString(formData, "fullName"),
        linkedinProfile: readString(formData, "linkedinProfile"),
        role: readString(formData, "role"),
        workEmail: readString(formData, "workEmail"),
        companySize: readString(formData, "companySize"),
        industry: readString(formData, "industry"),
        internalTechCapacity: readString(formData, "internalTechCapacity"),
        primaryOperationalBottleneck: readString(formData, "primaryOperationalBottleneck"),
        repetitiveTaskVolume: readString(formData, "repetitiveTaskVolume"),
        currentSystemsAndTools: readString(formData, "currentSystemsAndTools"),
        estimatedBusinessImpact: readString(formData, "estimatedBusinessImpact"),
        timelineOrConstraints: readString(formData, "timelineOrConstraints"),
        submittedAt: new Date().toISOString(),
      };
    };

    const submitPayload = async (payload) => {
      const response = await fetch(webhookUrl, {
        body: JSON.stringify(payload),
        headers: {
          "Content-Type": "application/json",
        },
        method: "POST",
      });

      const responseBody = await response.text();

      if (!response.ok) {
        throw new FormSubmissionError(
          `AI automation submission failed with status ${response.status}.`,
          response.status,
          responseBody,
        );
      }
    };

    const setButtonsDisabled = (isDisabled) => {
      qualifiedSubmitButton.disabled = isDisabled;
    };

    const setQualifiedSubmittingState = (isSubmitting) => {
      qualifiedSubmitButton.innerHTML = isSubmitting
        ? "Submitting..."
        : qualifiedSubmitLabel;
    };

    const createActionableErrorMessage = (error) => {
      if (error instanceof FormSubmissionError) {
        // const bodyPreview = error.responseBody.trim();
        // return `Unable to submit your application right now. Status ${error.statusCode}. Response: ${bodyPreview || "Empty response body."}`;
      }

      if (error instanceof Error) {
        // return `Unable to submit your application right now. ${error.message}`;
      }

      return "Unable to submit your application right now. Please try again in a few minutes.";
    };

    const moveFromContactToQualification = () => {
      if (!validateStep("contact")) {
        return;
      }

      sendGtagEvent("ai_automation_form_step_complete", {
        page_path: window.location.pathname,
        step_name: "contact",
        step_number: stepNumbers.contact,
      });
      showStep("qualification");
      scrollFormToTop();
    };

    const moveFromQualification = () => {
      if (!validateStep("qualification")) {
        return;
      }

      sendGtagEvent("ai_automation_form_step_complete", {
        page_path: window.location.pathname,
        step_name: "qualification",
        step_number: stepNumbers.qualification,
      });
      showStep("diagnostic");
      scrollFormToTop();
    };

    const submitQualifiedApplication = async () => {
      if (!validateStep("diagnostic")) {
        return;
      }

      clearMessage();
      setButtonsDisabled(true);
      setQualifiedSubmittingState(true);

      sendGtagEvent("ai_automation_form_submit_attempt", {
        page_path: window.location.pathname,
        step_name: "diagnostic",
        step_number: stepNumbers.diagnostic,
      });

      try {
        if (triggerSubmit()) {
          const payload = createQualifiedSubmission(new FormData(form));
          await submitPayload(payload);
        }
        sendGtagEvent("ai_automation_form_step_complete", {
          page_path: window.location.pathname,
          step_name: "diagnostic",
          step_number: stepNumbers.diagnostic,
        });
        sendGtagEvent("ai_automation_form_submit_success", {
          page_path: window.location.pathname,
        });
        showQualifiedTerminal();
      } catch (error) {
        sendGtagEvent("ai_automation_form_submit_error", {
          error_name: error instanceof Error ? error.name : "UnknownError",
          page_path: window.location.pathname,
          status_code: error instanceof FormSubmissionError ? error.statusCode : "",
        });
        showErrorMessage(createActionableErrorMessage(error));
      } finally {
        setQualifiedSubmittingState(false);
        setButtonsDisabled(false);
      }
    };

    nextContactButton.addEventListener("click", moveFromContactToQualification);
    backContactButton.addEventListener("click", () => {
      showStep("contact");
    });
    nextQualificationButton.addEventListener("click", moveFromQualification);
    backQualificationButtons.forEach((button) => {
      button.addEventListener("click", () => {
        showStep("qualification");
      });
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitQualifiedApplication();
    });

    sendGtagEvent("ai_automation_form_step_view", {
      page_path: window.location.pathname,
      step_name: "contact",
      step_number: stepNumbers.contact,
    });
  };

  initAIAutomationForm();
  document.addEventListener("astro:page-load", initAIAutomationForm);
</script>

<style>
  .review-form-root {
    display: grid;
    gap: 1.5rem;
  }

  .review-form-message {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .review-form-message[data-state="error"] {
    border-color: rgb(248 113 113 / 0.28);
    background: rgb(127 29 29 / 0.18);
    color: rgb(254 202 202);
  }

  .review-form-message[data-state="success"] {
    border-color: rgb(253 186 116 / 0.3);
    background: rgb(253 186 116 / 0.12);
    color: rgb(255 237 213);
  }

  .review-step,
  .review-terminal {
    display: grid;
    gap: 2rem;
  }

  .review-step-head {
    display: grid;
    gap: 0.85rem;
  }

  .review-step-copy {
    margin: 0;
    color: rgb(212 212 216);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .review-compact-copy {
    color: rgb(161 161 170);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .review-field-group {
    display: grid;
    gap: 1.5rem;
  }

  .review-field,
  .review-fieldset {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .review-label {
    color: white;
    font-size: 1.05rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .review-required {
    color: rgb(253 186 116);
  }

  .review-help {
    color: rgb(161 161 170);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.7;
  }

  .review-input {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.5rem;
    background-color: rgb(255 255 255 / 0.04);
    color: white;
    font: inherit;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .review-input::placeholder {
    color: rgb(161 161 170);
  }

  .review-input:hover {
    border-color: rgb(255 255 255 / 0.16);
  }

  .review-input:focus {
    outline: none;
    border-color: rgb(253 186 116 / 0.9);
    box-shadow: 0 0 0 0.2rem rgb(253 186 116 / 0.14);
    background-color: rgb(255 255 255 / 0.06);
  }

  .review-select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, rgb(161 161 170) 50%),
