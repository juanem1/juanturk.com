---
interface ArchitectureAssessmentCarouselItem {
  readonly body: string;
  readonly title: string;
}

interface Props {
  readonly items: readonly ArchitectureAssessmentCarouselItem[];
  readonly title: string;
}

const { items, title }: Props = Astro.props;
const slideIdPrefix = `assessment-carousel-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

if (title.trim().length === 0) {
  throw new Error("ArchitectureAssessmentCarousel requires a non-empty title.");
}

if (items.length === 0) {
  throw new Error("ArchitectureAssessmentCarousel requires at least one item.");
}
---

<section class="assessment-carousel" data-assessment-carousel aria-label={title}>
  <div class="assessment-carousel-copy">
    <h2 class="text-2xl font-[720] tracking-tighter text-white sm:text-3xl lg:text-[2.15rem]">{title}</h2>
  </div>

  <div class="assessment-carousel-viewport">
    <div class="assessment-carousel-track" data-carousel-track>
      {items.map((item, index) => (
        <article
          class="assessment-carousel-slide"
          id={`${slideIdPrefix}-slide-${index}`}
          data-carousel-slide
          data-active={index === 0 ? "true" : "false"}
          aria-hidden={index === 0 ? "false" : "true"}
          role="tabpanel"
        >
          <p class="text-sm font-semibold uppercase tracking-widest text-orange-300 mb-4">{item.title}</p>
          <p class="max-w-3xl leading-7 text-zinc-300 sm:text-lg sm:leading-8">{item.body}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="assessment-carousel-pagination" role="tablist" aria-label={`${title} slides`}>
    {items.map((item, index) => (
      <button
        type="button"
        class="assessment-carousel-dot"
        data-carousel-dot
        data-active={index === 0 ? "true" : "false"}
        aria-label={`Show slide ${index + 1}: ${item.title}`}
        aria-controls={`${slideIdPrefix}-slide-${index}`}
        aria-current={index === 0 ? "true" : "false"}
        aria-selected={index === 0 ? "true" : "false"}
        role="tab"
      />
    ))}
  </div>
</section>

<script is:inline>
  const script = document.currentScript;
  const root = script?.previousElementSibling;

  if (!(root instanceof HTMLElement) || root.dataset.assessmentCarousel === undefined) {
    throw new Error("ArchitectureAssessmentCarousel root element not found.");
  }

  const AUTO_ADVANCE_MS = 4800;
  const track = root.querySelector("[data-carousel-track]");
  const slides = Array.from(root.querySelectorAll("[data-carousel-slide]"));
  const dots = Array.from(root.querySelectorAll("[data-carousel-dot]"));

  if (!(track instanceof HTMLElement)) {
    throw new Error("ArchitectureAssessmentCarousel track element not found.");
  }

  if (slides.length === 0 || dots.length !== slides.length) {
    throw new Error("ArchitectureAssessmentCarousel requires matching slides and dots.");
  }

  let activeIndex = 0;
  let intervalId = null;

  const sync = () => {
    track.style.transform = `translate3d(-${activeIndex * 100}%, 0, 0)`;

    slides.forEach((slide, index) => {
      const isActive = index === activeIndex;
      slide.dataset.active = isActive ? "true" : "false";
      slide.setAttribute("aria-hidden", isActive ? "false" : "true");
    });

    dots.forEach((dot, index) => {
      const isActive = index === activeIndex;
      dot.dataset.active = isActive ? "true" : "false";
      dot.setAttribute("aria-selected", isActive ? "true" : "false");
      dot.setAttribute("aria-current", isActive ? "true" : "false");
    });
  };

  const startAutoAdvance = () => {
    if (intervalId !== null) {
      return;
    }

    intervalId = window.setInterval(() => {
      activeIndex = (activeIndex + 1) % slides.length;
      sync();
    }, AUTO_ADVANCE_MS);
  };

  const stopAutoAdvance = () => {
    if (intervalId !== null) {
      window.clearInterval(intervalId);
      intervalId = null;
    }
  };

  const restartAutoAdvance = () => {
    stopAutoAdvance();
    startAutoAdvance();
  };

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      activeIndex = index;
      sync();
      restartAutoAdvance();
    });
  });

  root.addEventListener("mouseenter", stopAutoAdvance);
  root.addEventListener("mouseleave", startAutoAdvance);
  root.addEventListener("focusin", stopAutoAdvance);
  root.addEventListener("focusout", (event) => {
    const nextTarget = event.relatedTarget;

    if (nextTarget instanceof Node && root.contains(nextTarget)) {
      return;
    }

    startAutoAdvance();
  });

  sync();
  startAutoAdvance();
</script>

<style>
  .assessment-carousel {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 0;
  }

  .assessment-carousel-copy,
  .assessment-carousel-slide {
    margin: 0;
  }

  .assessment-carousel-copy,
  .assessment-carousel-viewport,
  .assessment-carousel-track {
    width: 100%;
  }

  .assessment-carousel-viewport {
    overflow: hidden;
  }

  .assessment-carousel-track {
    display: flex;
    will-change: transform;
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .assessment-carousel-slide {
    box-sizing: border-box;
    /* display: flex; */
    width: 100%;
    min-width: 100%;
    /* flex-direction: column; */
    /* gap: 1.75rem; */
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.02)),
      rgb(39 44 52 / 0.96);
    padding: 0.75rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 28px 80px -40px rgb(9 12 17 / 0.88);
    opacity: 0.6;
    transform: scale(0.975);
    transition:
      opacity 420ms ease,
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms ease,
      box-shadow 420ms ease;
  }

  .assessment-carousel-slide[data-active="true"] {
    border-color: rgb(255 255 255 / 0.16);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 34px 90px -42px rgb(9 12 17 / 0.96);
    opacity: 1;
    transform: scale(1);
  }

  .assessment-carousel-pagination {
    display: flex;
    width: 100%;
    justify-content: center;
    gap: 0.75rem;
  }

  .assessment-carousel-dot {
    position: relative;
    height: 0.875rem;
    width: 0.875rem;
    border: 0;
    border-radius: 9999px;
    background: rgb(253 186 116 / 0.36);
    cursor: pointer;
    padding: 0;
    transition:
      width 280ms ease,
      transform 280ms ease,
      background-color 280ms ease,
      box-shadow 280ms ease,
      opacity 280ms ease;
  }

  .assessment-carousel-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(253 186 116);
    opacity: 0;
    transform: scale(0.72);
    transition:
      opacity 280ms ease,
      transform 280ms ease;
  }

  .assessment-carousel-dot:hover,
  .assessment-carousel-dot:focus-visible {
    transform: translateY(-1px);
    background: rgb(253 186 116 / 0.56);
    outline: none;
  }

  .assessment-carousel-dot[data-active="true"] {
    width: 2.25rem;
    background: rgb(253 186 116 / 0.22);
    box-shadow: 0 0 0 1px rgb(253 186 116 / 0.18);
  }

  .assessment-carousel-dot[data-active="true"]::after {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 640px) {
    .assessment-carousel {
      gap: 1.75rem;
    }
  }
</style>
