---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import globalStylesHref from "../styles/global.css?url";

type JsonLdValue =
  | string
  | number
  | boolean
  | null
  | JsonLdObject
  | JsonLdValue[];

interface JsonLdObject {
  [key: string]: JsonLdValue;
}

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  ogImage?: string;
  pageType?: "personal" | "blog";
  bodyClass?: string;
  htmlClass?: string;
  mainClass?: string;
}

const {
  title,
  description = "Software engineer writing about AI, automation, and the operational reality behind building reliable software.",
  ogType = "website",
  ogImage,
  pageType,
  bodyClass = "min-h-screen text-zinc-100 antialiased",
  htmlClass = "bg-fixed bg-[linear-gradient(180deg,#1c2128,#22272e,#0d1117)]",
  mainClass = "", //mx-auto w-full max-w-6xl pb-10
} = Astro.props;
// const currentYear = new Date().getFullYear();
const siteUrl = Astro.site ?? Astro.url;
const siteName = "Juan Turk";
const siteLocale = "en_US";
const siteLanguage = "en-US";
const themeColor = "#0d1117";
const twitterHandle = "@juanem1";
const defaultOgImagePath = "/og-image.png";
const siteRootUrl = new URL("/", siteUrl).href;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = new URL(ogImage ?? defaultOgImagePath, siteUrl).href;
const structuredDataType =
  ogType === "article" ? "Article" : pageType === "personal" ? "ProfilePage" : "WebPage";
const structuredData: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": structuredDataType,
  name: title,
  description,
  url: canonicalUrl,
  image: resolvedOgImage,
  inLanguage: siteLanguage,
  author: {
    "@type": "Person",
    name: siteName,
    url: siteRootUrl,
    sameAs: [
      "https://github.com/juanem1",
      "https://www.linkedin.com/in/juanemilioturk/",
    ],
  },
  publisher: {
    "@type": "Person",
    name: siteName,
    url: siteRootUrl,
  },
  isPartOf: {
    "@type": "WebSite",
    name: siteName,
    url: siteRootUrl,
  },
};
---

<html
  lang="en"
  transition:name="root"
  transition:animate="none"
  class={htmlClass}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-mona-sans" preload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={siteLocale} />
    {pageType && <meta name="page-type" content={pageType} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LSXP9WJT42"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-LSXP9WJT42");
    </script>
    <link rel="preload" href={globalStylesHref} as="style" />
    <link rel="stylesheet" href={globalStylesHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={globalStylesHref} />
    </noscript>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot name="header" />

    <main transition:animate="fade" class={mainClass}>
      <slot />
    </main>

    <!-- <footer class="mx-auto max-w-6xl border-t border-white/8 px-5 py-8 text-center text-sm text-zinc-500 sm:px-8 lg:px-10">
      <p>&copy; Juan Turk · 2023 - {currentYear}</p>
    </footer> -->
  </body>
</html>
