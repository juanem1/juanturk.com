---
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  headerTransparent?: boolean;
}

const { title, description, ogType, ogImage, headerTransparent } = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType} ogImage={ogImage}>
  <SiteHeader slot="header" transparent={headerTransparent} />
  <div class="backdrop" aria-hidden="true" />
  <div class="mx-auto w-full max-w-6xl pb-10 px-5 sm:px-8 lg:px-10">
    <slot />
  </div>
  <style>
    .backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100dvw;
      height: 100dvh;
      background:
        radial-gradient(circle at top right, rgb(253 186 116 / 0.24), transparent 24rem),
        radial-gradient(circle at 70% 40%, rgb(255 255 255 / 0.07), transparent 22rem),
        radial-gradient(circle at 10% 70%, rgb(253 180 120 / 0.07), transparent 18rem),
        linear-gradient(180deg, rgb(13 17 23), rgb(17 21 29) 42%, rgb(13 17 23));
    }
  </style>
</BaseLayout>
