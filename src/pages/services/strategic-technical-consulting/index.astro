---
import { Font, getImage } from "astro:assets";
import { TrendingUp, Gauge, CloudUpload, RefreshCcw, ShieldAlert, GitBranchPlus, ArrowRight } from '@lucide/astro';
import SiteLayout from "../../../layouts/SiteLayout.astro";
import Divider from "../../../components/Divider.astro"
import WhoAmI from "../../../components/WhoAmI.astro";
import profilePicture from "../../../assets/images/new_profile_picture.png";

const optimizedBg = await getImage({ src: profilePicture });
const title = "Strategic Technical Review";
const description =
  "A selective one-call technical diagnostic for founders and engineering leaders making high-stakes architecture, scalability, and delivery decisions.";

const architectureAssessmentItems = [
  {
    icon: TrendingUp,
    title: "Scaling your business operations",
    body:
      "Preparing for significant growth or handling an increase in user demand. A diagnostic ensures your architecture can support the expansion without performance dips.",
  },
  {
    icon: GitBranchPlus,
    title: "Planning for major updates",
    body:
      "Adding new features, transitioning to microservices, or integrating with third-party tools? Ensure your architecture is ready to handle the changes seamlessly.",
  },
  {
    icon: Gauge,
    title: "System performance issues",
    body:
      "Facing slow response times, system outages, or unexplained inefficiencies? Identify the root cause of growth-stifling bottlenecks before they impact your LTV.",
  },
  {
    icon: CloudUpload,
    title: "Exploring cloud migration",
    body:
      "Moving to the cloud or optimizing your current cloud setup? An architecture review can ensure the transition is smooth and efficient.",
  },
  {
    icon: RefreshCcw,
    title: "Modernizing legacy systems",
    body:
      "Struggling with outdated technology? Get a clear technical direction on whether to refactor, migrate, or rebuild.",
  },
  {
    icon: ShieldAlert,
    title: "Addressing security concerns",
    body:
      "Concerned about vulnerabilities or compliance? An architecture review can identify risks and provide a roadmap to fortify your defenses.",
  },
];

const reviewProcessSteps = [
  {
    title: "Start with the application",
    body: "You submit a short application form with your business context, your team structure, and high-level information about the technical issue or decision.",
  },
  {
    title: "Assess applicability and NDA",
    body: "Upon finding the technical problem to be a good fit, we will sign an NDA to ensure that all internal information can be discussed openly.",
  },
  {
    title: "Collect the technical context",
    body: "I will request architecture details, incident reports, technical constraints, product context, and other relevant details that will allow me to assess the system thoroughly.",
  },
  {
    title: "Run the diagnostic session",
    body: "A one-time 60-minute session to clarify assumptions, understand business direction, and identify the technical bottlenecks blocking progress.",
  },
  {
    title: "Receive a technical guidance",
    body: "Your deliverable will be a video walkthrough and PDF file outlining the trade-off and guidance with actionable insights for your team.",
  },
];
---

<Font cssVariable="--font-editorial-new" preload />
<SiteLayout title={title} description={description}>
  
  <section class="motion-enter h-[calc(100dvh - 73px)] pt-18.25" data-strategic-review-landing>
    <div class="mx-auto flex lg:min-h-[clamp(800px,78svh,800px)] w-full items-center">
      <div class="max-w-4xl space-y-7">
        <p class="motion-enter text-sm font-semibold uppercase tracking-widest text-orange-300" style="--motion-step: 0;">
          Selective technical advisory
        </p>

        <div class="space-y-5">
          <h1 class="motion-enter max-w-4xl text-5xl font-bold tracking-tight text-white lg:text-8xl font-(family-name:--font-editorial-new)" style="--motion-step: 1;">
            Strategic Technical Review
          </h1>
          <p class="motion-enter max-w-2xl text-lg leading-8 text-pretty text-zinc-200 sm:text-[1.35rem] sm:leading-9" style="--motion-step: 2;">
            One sharp diagnostic call for founders and technical leaders facing high-stakes decisions, scaling pressure, or stubborn engineering bottlenecks
          </p>
        </div>

        <div class="motion-enter flex flex-col gap-3 pt-2 sm:flex-row" style="--motion-step: 3;">
          <a
            href="#process"
            class="interactive-chip cta-with-rotate inline-flex items-center justify-center gap-2 rounded-full bg-orange-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-orange-200"
          >
            See the process
            <ArrowRight class="cta-arrow" size={16} stroke-width={2.5} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- Who am I -->
  <WhoAmI optimizedBg={optimizedBg} />

  <Divider />

  <!-- When your system needs a technical diagnosis -->
  <section aria-labelledby="diagnosis-heading">
    <div class="mb-12 text-center space-y-5 lg:mb-16">
      <h2 id="diagnosis-heading" class="motion-enter text-3xl font-[720] tracking-tight text-white md:text-4xl lg:text-6xl font-(family-name:--font-editorial-new)" style="--motion-step: 0;">
        When your system <em class="text-orange-300">needs</em> a technical diagnosis
      </h2>
      <p class="motion-enter leading-7 text-pretty text-zinc-300 sm:text-lg sm:leading-8" style="--motion-step: 1;">
        Not every system needs an outside read. But when the wrong call gets expensive, a sharp diagnostic pays for itself. These are the six moments where it matters most.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-12 gap-y-9 sm:grid-cols-2 lg:gap-x-16">
      {architectureAssessmentItems.map((item, index) => {
        const Icon = item.icon;
        return (
          <article
            class="motion-enter group relative flex gap-5 border-t border-white/10 pt-7"
            style={`--motion-step: ${index + 2};`}
          >
            <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-300/10 text-orange-300 ring-1 ring-inset ring-orange-300/20 transition duration-300 group-hover:bg-orange-300/20 group-hover:ring-orange-300/40">
              <Icon size={22} stroke-width={1.75} aria-hidden="true" />
            </span>
            <div class="space-y-2.5">
              <h3 class="text-xl font-[620] tracking-tight text-white transition-colors duration-300 group-hover:text-orange-200 font-(family-name:--font-editorial-new)">
                {item.title}
              </h3>
              <p class="leading-7 text-zinc-400">{item.body}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <Divider id="process" />

  <!-- Process -->
  <section class="motion-enter">
    <div class="mx-auto w-full">
      <div class="space-y-5">
        <div class="motion-enter" style="--motion-step: 1;">
          <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl lg:text-6xl font-(family-name:--font-editorial-new) mb-8">
            A focused process for <em class="text-orange-300">better</em> technical decisions.
          </h2>
        </div>

        <ol class="m-0 p-0 list-none">
          {reviewProcessSteps.map((step, index) => (
            <li class="motion-enter grid gap-4 grid-cols-[2rem_minmax(0,1fr)]" style={`--motion-step: ${index + 2};`}>
              <div class="relative flex justify-center pt-[0.35rem]" aria-hidden="true">
                <span class="relative z-1 flex h-3.5 w-3.5">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[rgb(253_186_116)] opacity-75" />
                  <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-[rgb(253_186_116)] [box-shadow:0_0_0_0.5rem_rgb(253_186_116/0.08)]" />
                </span>
                {index < reviewProcessSteps.length - 1 && <span class="absolute top-5 bottom-0 w-px bg-[linear-gradient(180deg,rgb(253_186_116/0.6),rgb(255_255_255/0.08))]" />}
              </div>
              <div class="space-y-3 pb-10">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-300">
                  Step 0{index + 1}
                </p>
                <h3 class="text-2xl font-[720] tracking-[-0.04em] text-white">
                  {step.title}
                </h3>
                <p class="leading-6 text-zinc-400 sm:text-lg sm:leading-8">
                  {step.body}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Divider />

  <!-- Who is this for -->
  <section aria-labelledby="fit-heading" class="motion-enter">
    <h2 id="fit-heading" class="mb-5 text-3xl font-[720] tracking-tight text-white md:text-4xl lg:text-6xl text-center font-(family-name:--font-editorial-new)">
      Who is this for
    </h2>
    <p class="leading-7 text-pretty text-zinc-300 sm:text-lg sm:leading-8 text-center">
      Best fit for founders, technical leaders, and companies that need a sharp external
      diagnostic before making an important technical decision, untangling a costly
      bottleneck, or defining the right architecture for the next stage of growth.<br />
      Designed for teams that need Big Tech rigor without the overhead of a full-time executive hire.
    </p>
  </section>

  <Divider />

  <!-- Apply -->
  <section id="apply" class="motion-enter">
    <div class="motion-enter" style="--motion-step: 0;">
      <h2 class="text-3xl font-[760] tracking-tight text-white md:text-4xl lg:text-6xl font-(family-name:--font-editorial-new)">
        If the decision is material, <em class="text-orange-300">start</em> with the context
      </h2>
      <p class="mt-4 leading-7 text-pretty text-zinc-300 sm:text-lg sm:leading-8">
        The application covers the business stakes, current technical reality, and the decision you need to validate before this review is considered.
      </p>
      <div class="flex flex-col gap-5 pt-8 md:flex-row">
        <a
          href="/services/strategic-technical-consulting/apply"
          data-strategic-review-cta="apply_page"
          class="interactive-chip cta-with-arrow mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-orange-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-orange-200"
        >
          Apply for review
          <ArrowRight class="cta-arrow" size={16} stroke-width={2.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const trackStrategicReviewLanding = () => {
    const landingRoot = document.querySelector("[data-strategic-review-landing]");

    if (!(landingRoot instanceof HTMLElement) || landingRoot.dataset.analyticsInitialized === "true") {
      return;
    }

    landingRoot.dataset.analyticsInitialized = "true";
    // @ts-expect-error
    const sendGtagEvent = (eventName, eventParams) => {
      // @ts-expect-error
      if (typeof window.gtag !== "function") {
        return;
      }
      // @ts-expect-error
      window.gtag("event", eventName, eventParams);
    };

    sendGtagEvent("strategic_review_landing_view", {
      page_path: window.location.pathname,
      page_type: "landing",
    });

    const ctaLinks = document.querySelectorAll("[data-strategic-review-cta]");

    ctaLinks.forEach((ctaLink) => {
      if (!(ctaLink instanceof HTMLAnchorElement)) {
        return;
      }

      ctaLink.addEventListener("click", () => {
        sendGtagEvent("strategic_review_apply_cta_click", {
          cta_location: ctaLink.dataset.strategicReviewCta,
          destination_path: ctaLink.getAttribute("href") || "",
          page_path: window.location.pathname,
        });
      });
    });
  };

  trackStrategicReviewLanding();
  document.addEventListener("astro:page-load", trackStrategicReviewLanding);
</script>
