---
import { Font } from "astro:assets";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";

interface ChoiceOption {
  readonly label: string;
  readonly value: string;
}

const title = "Apply for AI & Automation Consulting";
const description =
  "Submit your application for an AI & Automation operational diagnosis and share the bottleneck, task volume, systems, and business impact behind it.";
const sourcePath = "/services/ai-automation-consulting/apply";
const strategicReviewWebhookUrl = import.meta.env.PUBLIC_WORKER_URL;
const skipSubmitForTesting = import.meta.env.PUBLIC_SKIP_SUBMIT_FOR_TESTING;

if (typeof strategicReviewWebhookUrl !== "string" || strategicReviewWebhookUrl.length === 0) {
  throw new Error("Missing PUBLIC_WORKER_URL for AI automation apply form.");
}

const webhookUrl = new URL("/ia-consulting", strategicReviewWebhookUrl).toString();

const roleOptions: readonly ChoiceOption[] = [
  { label: "COO / Head of Operations", value: "COO / Head of Operations" },
  { label: "CFO / Head of Finance", value: "CFO / Head of Finance" },
  { label: "Owner / CEO", value: "Owner / CEO" },
  { label: "Operations Manager", value: "Operations Manager" },
  { label: "Other", value: "Other" },
];
const companySizeOptions: readonly ChoiceOption[] = [
  { label: "Under 50 employees", value: "Under 50 employees" },
  { label: "50-150 employees", value: "50-150 employees" },
  { label: "150-300 employees", value: "150-300 employees" },
  { label: "300-500 employees", value: "300-500 employees" },
  { label: "500+ employees", value: "500+ employees" },
];
const industryOptions: readonly ChoiceOption[] = [
  { label: "Logistics", value: "Logistics" },
  { label: "Finance", value: "Finance" },
  { label: "Legal", value: "Legal" },
  { label: "Manufacturing", value: "Manufacturing" },
  { label: "Other", value: "Other" },
];
const internalTechCapacityOptions: readonly ChoiceOption[] = [
  { label: "Yes, we have an in-house tech team", value: "Yes, we have an in-house tech team" },
  {
    label: "Partially, a few technical people but no dedicated team",
    value: "Partially, a few technical people but no dedicated team",
  },
  { label: "No internal tech talent", value: "No internal tech talent" },
];
---

<Font cssVariable="--font-editorial-new" preload />
<SiteLayout title={title} description={description}>
  <section class="motion-enter" data-ai-automation-apply-page>
    <div class="mx-auto flex w-full flex-col gap-8 pb-14 pt-30 sm:pb-20 sm:pt-32">
      <div>
        <h1 class="mb-10 text-4xl font-bold tracking-tight text-white md:text-6xl lg:text-8xl font-(family-name:--font-editorial-new)">
          AI & Automation Audit Application
        </h1>
        <p class="mb-3 text-pretty text-zinc-300">This application helps me understand your business context, your operational reality, the repetitive work slowing you down, and the systems involved. It allows me to assess whether automation can deliver a measurable return before scheduling any session.</p>
        <p class="mb-3 text-pretty text-zinc-300">You'll be asked for basic contact details, company and industry context, the main operational bottleneck, task volume, current systems, business impact, and any relevant deadlines or constraints.</p>
        <p class="text-zinc-400 italic">Usually takes between 5 to 10 minutes to complete</p>
      </div>
    </div>
  </section>

  <section class="motion-enter pb-20">
    <div class="mx-auto w-full">
      <div
        data-ai-automation-form
        data-source-path={sourcePath}
        data-webhook-url={webhookUrl}
        data-skip-submit-for-testing={skipSubmitForTesting ?? ""}
        class="review-form-root"
      >
        <div class="review-form-message" data-form-message role="status" aria-live="polite" hidden />

        <form data-review-form class="review-form">
          <section data-step-panel="contact" class="review-step">
            <div class="review-step-head">
              <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 1 of 3</p>
              <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
                Business information
              </h3>
            </div>

            <div class="review-field-group">
              <label class="review-field" for="fullName">
                <span class="review-label">Full name <span class="review-required">*</span></span>
                <input
                  class="review-input"
                  id="fullName"
                  name="fullName"
                  type="text"
                  autocomplete="name"
                  required
                />
              </label>

              <label class="review-field" for="workEmail">
                <span class="review-label">Email <span class="review-required">*</span></span>
                <input
                  class="review-input"
                  id="workEmail"
                  name="workEmail"
                  type="email"
                  autocomplete="email"
                  placeholder="Where I should send the next steps"
                  required
                />
              </label>

              <label class="review-field" for="companyWebsite">
                <span class="review-label">Company website <span class="review-required">*</span></span>
                <input
                  class="review-input"
                  id="companyWebsite"
                  name="companyWebsite"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  placeholder="I'll use this to understand your business before our session"
                  required
                />
              </label>

              <label class="review-field" for="linkedinProfile">
                <span class="review-label">LinkedIn profile <span class="review-required">*</span></span>
                <input
                  class="review-input"
                  id="linkedinProfile"
                  name="linkedinProfile"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  required
                />
              </label>

              <label class="review-field" for="role">
                <span class="review-label">Your role <span class="review-required">*</span></span>
                <select class="review-input review-select" id="role" name="role" required>
                  <option value="">Select your role</option>
                  {roleOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>

            <div class="review-actions">
              <button type="button" class="review-button review-button-primary" data-action="next-contact">
                Continue
                <ArrowRight />
              </button>
            </div>
          </section>

          <section data-step-panel="qualification" class="review-step" hidden>
            <div class="review-step-head">
              <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 2 of 3</p>
              <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">Fit & readiness</h3>
            </div>

            <div class="review-field-group">
              <label class="review-field" for="companySize">
                <span class="review-label">Company size <span class="review-required">*</span></span>
                <select
                  class="review-input review-select"
                  id="companySize"
                  name="companySize"
                  required
                >
                  <option value="">Select your company size</option>
                  {companySizeOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>

              <label class="review-field" for="industry">
                <span class="review-label">Industry <span class="review-required">*</span></span>
                <select
                  class="review-input review-select"
                  id="industry"
                  name="industry"
                  required
                >
                  <option value="">Select your industry</option>
                  {industryOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>

              <label class="review-field" for="implementationCapacity">
                <span class="review-label">Internal tech capacity <span class="review-required">*</span></span>
                <span class="review-step-copy review-compact-copy">
                  Do you have internal technical talent to build and maintain automations today?
                </span>
                <select
                  class="review-input review-select"
                  id="implementationCapacity"
                  name="implementationCapacity"
                  required
                >
                  <option value="">Select your internal tech capacity</option>
                  {internalTechCapacityOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>

            <div class="review-actions">
              <button type="button" class="review-button review-button-secondary" data-action="back-contact">
                <ArrowLeft /> Back
              </button>
              <button type="button" class="review-button review-button-primary" data-action="next-qualification">
                Continue to operational details
                <ArrowRight />
              </button>
            </div>
          </section>

          <section data-step-panel="diagnostic" class="review-step" hidden>
            <div class="review-step-head">
              <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Page 3 of 3</p>
              <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">Operational diagnostic</h3>
            </div>

            <div class="review-field-group">
              <label class="review-field" for="primaryBottleneck">
                <span class="review-label">
                  What is the primary operational bottleneck you need to solve? <span class="review-required">*</span>
                </span>
                <span class="review-step-copy review-compact-copy">
                  Describe the manual, repetitive process that is slowing your team down (e.g. &quot;Our
                  team re-types invoice data from email into our ERP by hand every day&quot;).
                </span>
                <textarea
                  class="review-input review-textarea"
                  id="primaryBottleneck"
                  name="primaryBottleneck"
                  placeholder="Describe the process, who runs it, and where the friction is"
                  required
                  rows="5"
                />
              </label>

              <label class="review-field" for="repetitiveTaskVolume">
                <span class="review-label">Task volume & frequency <span class="review-required">*</span></span>
                <span class="review-step-copy review-compact-copy">
                  Help me size the opportunity. How often does this happen, and how much staff time does
                  it consume?
                </span>
                <textarea
                  class="review-input review-textarea"
                  id="repetitiveTaskVolume"
                  name="repetitiveTaskVolume"
                  placeholder="e.g. 3 people spend ~4 hours/day on this, around 800 records processed per week"
                  required
                  rows="4"
                />
              </label>

              <label class="review-field" for="currentTechStack">
                <span class="review-label">Current systems & tools <span class="review-required">*</span></span>
                <span class="review-step-copy review-compact-copy">
                  List the core software and systems involved in this process so I can map the integration.
                </span>
                <textarea
                  class="review-input review-textarea"
                  id="currentTechStack"
                  name="currentTechStack"
                  placeholder="ERP, CRM, spreadsheets, email, internal databases, etc."
                  required
                  rows="4"
                />
              </label>

              <label class="review-field" for="estimatedBusinessImpact">
                <span class="review-label">Estimated business impact <span class="review-required">*</span></span>
                <span class="review-step-copy review-compact-copy">
                  Help me quantify the cost of inaction. What does this bottleneck cost you in wasted
                  hours, errors, delays, or lost revenue?
                </span>
                <textarea
                  class="review-input review-textarea"
                  id="estimatedBusinessImpact"
                  name="estimatedBusinessImpact"
                  placeholder="e.g. ~60 staff hours/week lost, plus costly errors that require manual rework"
                  required
                  rows="4"
                />
              </label>

              <label class="review-field" for="constraints">
                <span class="review-label">Timeline or constraints</span>
                <span class="review-step-copy review-compact-copy">
                  Any deadlines, compliance requirements, or constraints I should be aware of.
                </span>
                <textarea
                  class="review-input review-textarea"
                  id="constraints"
                  name="constraints"
                  placeholder="e.g. We need this addressed before our Q4 peak season, data cannot leave the EU"
                  rows="4"
                />
              </label>
            </div>

            <div class="review-actions">
              <button type="button" class="review-button review-button-secondary" data-action="back-qualification">
                <ArrowLeft /> Back
              </button>
              <button
                type="submit"
                class="review-button review-button-primary"
                data-qualified-submit
              >
                Submit for review
                <ArrowRight />
              </button>
            </div>
          </section>
        </form>

        <section data-terminal-panel="qualified" class="review-terminal" hidden>
          <div class="review-step-head">
            <p class="text-sm font-semibold uppercase tracking-widest text-orange-300">Confirmation</p>
            <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
              Application received
            </h3>
            <p class="review-step-copy">
              Thank you for taking the time to complete this application. I personally review every submission to understand the operational reality behind each bottleneck and determine how AI and automation can deliver a measurable return for your business.
            </p>
          </div>
          <div class="review-terminal-copy">
            <h3 class="font-(family-name:--font-editorial-new) mt-3 text-3xl font-[760] tracking-[-0.04em] text-white sm:text-4xl">
              What happens next?
            </h3>
            <ol class="list-decimal list-inside text-zinc-300">
              <li><strong>Review:</strong> I will evaluate your operational context and the potential business impact within the next 48 hours.</li>
              <li><strong>Selection:</strong> To maintain the highest quality of delivery, I only accept a limited number of engagements each month, prioritizing projects where automation can unlock the most significant ROI.</li>
              <li>
                <strong>Next Steps:</strong> If there is a strategic fit, you will receive an email with:
                <ul class="list-disc list-inside">
                  <li>A secure payment link</li>
                  <li>An <strong>Operational Onboarding Checklist</strong> with instructions on how to share the process details, volumetry, and system access needed for the diagnosis.</li>
                  <li>Once I have the information, we will <strong>coordinate the next steps</strong> to kick off the operational diagnostic.</li>
                </ul>
              </li>
            </ol>
          </div>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { trackApplyPageView } from "../../../scripts/trackApplyPageView";

  const trackAIAutomationApplyPage = (): void => {
    trackApplyPageView({
      rootSelector: "[data-ai-automation-apply-page]",
      eventName: "ai_automation_apply_form",
    });
  };

  trackAIAutomationApplyPage();
  document.addEventListener("astro:page-load", trackAIAutomationApplyPage);
</script>

<script>
  import { initThreeStepApplyForm, readString } from "../../../scripts/initThreeStepApplyForm";

  const getAIAutomationFormRoot = (): HTMLDivElement => {
    const root = document.querySelector("[data-ai-automation-form]");

    if (!(root instanceof HTMLDivElement)) {
      throw new Error("AI automation form is missing root element.");
    }

    return root;
  };

  const readRequiredDatasetValue = (root: HTMLDivElement, key: string, context: string): string => {
    const value = root.dataset[key];

    if (typeof value !== "string" || value.length === 0) {
      throw new Error(`AI automation form is missing required dataset value: ${context}.`);
    }

    return value;
  };

  const readOptionalDatasetValue = (root: HTMLDivElement, key: string): string | undefined => {
    const value = root.dataset[key];

    if (typeof value !== "string" || value.length === 0) {
      return undefined;
    }

    return value;
  };

  const createAIAutomationPayload = (formData: FormData): Record<string, string> => {
    return {
      companySize: readString(formData, "companySize"),
      companyWebsite: readString(formData, "companyWebsite"),
      currentTechStack: readString(formData, "currentTechStack"),
      estimatedBusinessImpact: readString(formData, "estimatedBusinessImpact"),
      fullName: readString(formData, "fullName"),
      industry: readString(formData, "industry"),
      implementationCapacity: readString(formData, "implementationCapacity"),
      linkedinProfile: readString(formData, "linkedinProfile"),
      primaryBottleneck: readString(formData, "primaryBottleneck"),
      repetitiveTaskVolume: readString(formData, "repetitiveTaskVolume"),
      role: readString(formData, "role"),
      submittedAt: new Date().toISOString(),
      constraints: readString(formData, "constraints"),
      workEmail: readString(formData, "workEmail"),
    };
  };

  const initAIAutomationForm = (): void => {
    const root = getAIAutomationFormRoot();
    const sourcePathValue = readRequiredDatasetValue(root, "sourcePath", "sourcePath");
    const webhookUrlValue = readRequiredDatasetValue(root, "webhookUrl", "webhookUrl");
    const skipSubmitForTestingValue = readOptionalDatasetValue(root, "skipSubmitForTesting");

    initThreeStepApplyForm({
      createPayload: createAIAutomationPayload,
      eventPrefix: "ai_automation_form",
      formName: "ai_automation",
      missingElementContext: "AI automation form",
      rootSelector: "[data-ai-automation-form]",
      sentDatasetKey: "aiAutomationFormSent",
      skipSubmitForTesting: skipSubmitForTestingValue,
      sourcePath: sourcePathValue,
      submissionFailureLabel: "AI automation submission",
      userFacingSubmitErrorMessage: "Unable to submit your application right now. Please try again in a few minutes.",
      webhookUrl: webhookUrlValue,
    });
  };

  initAIAutomationForm();
  document.addEventListener("astro:page-load", initAIAutomationForm);
</script>

<style>
  .review-form-root {
    display: grid;
    gap: 1.5rem;
  }

  .review-form-message {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .review-form-message[data-state="error"] {
    border-color: rgb(248 113 113 / 0.28);
    background: rgb(127 29 29 / 0.18);
    color: rgb(254 202 202);
  }

  .review-form-message[data-state="success"] {
    border-color: rgb(253 186 116 / 0.3);
    background: rgb(253 186 116 / 0.12);
    color: rgb(255 237 213);
  }

  .review-step,
  .review-terminal {
    display: grid;
    gap: 2rem;
  }

  .review-step-head {
    display: grid;
    gap: 0.85rem;
  }

  .review-step-copy {
    margin: 0;
    color: rgb(212 212 216);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .review-compact-copy {
    color: rgb(161 161 170);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .review-field-group {
    display: grid;
    gap: 1.5rem;
  }

  .review-field,
  .review-fieldset {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .review-label {
    color: white;
    font-size: 1.05rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .review-required {
    color: rgb(253 186 116);
  }

  .review-help {
    color: rgb(161 161 170);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.7;
  }

  .review-input {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.5rem;
    background-color: rgb(255 255 255 / 0.04);
    color: white;
    font: inherit;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .review-input::placeholder {
    color: rgb(161 161 170);
  }

  .review-input:hover {
    border-color: rgb(255 255 255 / 0.16);
  }

  .review-input:focus {
    outline: none;
    border-color: rgb(253 186 116 / 0.9);
    box-shadow: 0 0 0 0.2rem rgb(253 186 116 / 0.14);
    background-color: rgb(255 255 255 / 0.06);
  }

  .review-select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, rgb(161 161 170) 50%),
      linear-gradient(135deg, rgb(161 161 170) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) calc(50% + 2px),
      calc(100% - 0.95rem) calc(50% + 2px);
    background-repeat: no-repeat;
    background-size: 0.4rem 0.4rem;
    padding-right: 2.8rem;
  }

  .review-textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .review-choice-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .review-choice {
    display: inline-flex;
  }

  .review-choice-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .review-choice-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: rgb(228 228 231);
    cursor: pointer;
    font-size: 0.98rem;
    line-height: 1.45;
    padding: 0.8rem 1.1rem;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .review-choice-input:focus-visible + .review-choice-label {
    outline: 2px solid rgb(253 186 116 / 0.75);
    outline-offset: 2px;
  }

  .review-choice-input:checked + .review-choice-label {
    border-color: rgb(253 186 116 / 0.78);
    background: rgb(253 186 116 / 0.14);
    color: rgb(255 237 213);
  }

  .review-choice:hover .review-choice-label {
    border-color: rgb(255 255 255 / 0.16);
    transform: translateY(-1px);
  }

  .review-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .review-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.98rem;
    font-weight: 760;
    min-height: 3.4rem;
    padding: 0.8rem 1rem;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .review-button:hover {
    transform: translateY(-1px);
  }

  .review-button:disabled {
    cursor: wait;
    opacity: 0.6;
    transform: none;
  }

  .review-button-primary {
    background: rgb(253 186 116);
    color: rgb(9 9 11);
  }

  .review-button-primary:hover {
    background: rgb(254 215 170);
  }

  .review-button-secondary {
    background: transparent;
    border-color: rgb(255 255 255 / 0.12);
    color: rgb(228 228 231);
  }

  .review-button-secondary:hover {
    background: rgb(255 255 255 / 0.05);
    border-color: rgb(255 255 255 / 0.2);
  }

  .review-terminal-copy {
    display: grid;
    gap: 0.9rem;
    color: rgb(228 228 231);
    font-size: 1rem;
    line-height: 1.85;
  }

  .review-terminal-copy p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .review-actions {
      flex-direction: column;
    }

    .review-button {
      width: 100%;
    }

    .review-choice {
      width: 100%;
    }

    .review-choice-label {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
