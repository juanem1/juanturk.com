---
import { Font } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

interface ServiceItem {
  readonly title: string;
  readonly description: string;
  readonly href: string;
  readonly audience: string;
}

const title = "Services";
const description =
  "A curated list of Juan Turk's consulting services for technical leaders and operational teams.";

const services: ReadonlyArray<ServiceItem> = [
  {
    title: "Strategic Technical Review",
    description:
      "A selective technical diagnostic for founders and engineering leaders making architecture, scalability, and delivery decisions under real pressure.",
    href: "/services/strategic-technical-consulting",
    audience:
      "Best fit for founders and technical leaders who need an external read before a material technical decision.",
  },
  {
    title: "AI & Automation Consulting",
    description:
      "An operational diagnosis and implementation blueprint for companies that want to remove manual work with reliable AI workflows.",
    href: "/services/ai-automation-consulting",
    audience:
      "Best fit for operational leaders dealing with repetitive processes, bottlenecks, and growth tied to headcount.",
  },
];
---

<Font cssVariable="--font-editorial-new" preload />
<SiteLayout title={title} description={description}>
  <section aria-labelledby="available-services" class="pt-18.25">
    <div class="my-16 space-y-5 text-center lg:my-25">
      <h1
        id="available-services"
        class="motion-enter text-5xl font-[720] tracking-tight text-white md:text-6xl lg:text-8xl font-(family-name:--font-editorial-new)"
        style="--motion-step: 0;"
      >
        Available services
      </h1>
      <p
        class="motion-enter mx-auto max-w-3xl text-lg leading-8 text-pretty text-zinc-200 sm:text-[1.35rem] sm:leading-9"
        style="--motion-step: 1;"
      >
        Each service has its own scope, selection criteria, and application flow. Pick the one
        that matches the decision or bottleneck you are dealing with.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-12 gap-y-9 sm:grid-cols-2 lg:gap-x-16">
      {services.map((service, index) => (
        <article
          class="motion-enter group relative border-t border-white/10 pt-7"
          style={`--motion-step: ${index + 2};`}
        >
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-300">
              Service 0{index + 1}
            </p>
            <h2 class="text-2xl font-[620] tracking-tight text-white transition-colors duration-300 group-hover:text-orange-200 font-(family-name:--font-editorial-new) sm:text-3xl">
              {service.title}
            </h2>
            <p class="leading-7 text-zinc-400 sm:text-lg sm:leading-8">
              {service.description}
            </p>
            <p class="leading-7 text-zinc-400">
              {service.audience}
            </p>
          </div>

          <div class="pt-6">
            <a
              href={service.href}
              class="interactive-chip cta-with-arrow inline-flex items-center gap-2 rounded-full bg-orange-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition-colors duration-200 ease-out hover:bg-orange-200"
            >
              View service
              <ArrowRight class="cta-arrow" size={16} stroke-width={2.5} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
