---
import { Font, Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import homeHeroLaptopHands from "../assets/images/home-hero-laptop-hands-transparent.png";
import { toPostSummary } from "../data/posts";

const posts = (await getCollection("posts"))
  .map(toPostSummary)
  .sort((a, b) => b.date.getTime() - a.date.getTime());
const latestPosts = posts.slice(0, 3);

const description =
  "Software engineer writing about AI, automation, software engineering, and the operational reality behind building reliable products and developer tools.";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Font cssVariable="--font-editorial-new" preload />
<SiteLayout
  title="Juan Turk | Software Engineering, AI, and Automation"
  description={description}
>
  <section aria-labelledby="about-me" class="mt-25 mb-5 lg:mt-45 lg:mb-40">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,28rem)] lg:gap-12">
      <div class="space-y-6">
        <h1
          id="about-me"
          class="font-(family-name:--font-editorial-new) text-4xl font-[750] leading-[0.92] text-white sm:text-6xl lg:text-7xl"
        >
          Hey, I&apos;m Juan Turk!
        </h1>
        <div class="text-emphasis space-y-4 leading-7 text-zinc-400 sm:text-lg sm:leading-8 lg:max-w-2xl lg:text-xl">
          <p>
            After 15+ years of <strong><em>building software</em></strong> across the stack and every stage of the development
            process, I always try to create simple solutions that are <strong><em>reliable</em></strong>, fail-safe, and have
            a true reason for existing.
          </p>
          <p>
            Lately, my curiosity has shifted toward <strong><em>automation</em></strong>, <strong><em>AI</em></strong>, and developing better software
            tools.
          </p>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:mx-0 hidden md:block">
        <div
          aria-hidden="true"
          class="absolute inset-x-10 top-8 h-24 rounded-full bg-orange-300/20 blur-3xl"
        />
        <div class="relative drop-shadow-[0_30px_80px_rgba(0,0,0,0.45)]">
          <Image
            src={homeHeroLaptopHands}
            alt="Top-down illustration of hands typing on a laptop with code on screen."
            class="home-hero-image h-auto w-full"
            widths={[640, 768, 896]}
            sizes="(min-width: 1024px) 28rem, (min-width: 640px) 24rem, 100vw"
            format="webp"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="recent-posts" class="py-8 sm:py-10">
    <div class="flex flex-col gap-4 mb-10 dm:mb-15 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl space-y-3">
        <h2 id="recent-posts" class="text-3xl font-[760] tracking-[-0.05em] text-white sm:text-4xl">
          Check my recent blog posts
        </h2>
        <p class="leading-7 text-zinc-400">
          Check my latest posts and explore the ideas, lessons, and experiments I keep publishing over time.
        </p>
      </div>

      <a
        href="/blog/"
        class="interactive-chip w-full text-center inline-flex items-center justify-center self-start rounded-full bg-orange-300 px-4 py-2.5 text-sm font-semibold text-zinc-950 transition-colors duration-200 ease-out hover:bg-orange-200 md:w-auto"
      >
        Browse all posts
      </a>
    </div>

    <div class="grid gap-y-8 lg:grid-cols-[minmax(0,1fr)_3rem_minmax(0,1fr)_3rem_minmax(0,1fr)]">
      {latestPosts.map((post, index) => (
        <div class="group contents">
          {index > 0 && (
            <div
              aria-hidden="true"
              class="hidden w-px justify-self-center self-stretch bg-white/10 transition-colors duration-300 group-hover:bg-orange-300/35 lg:block"
            />
          )}

          <a
            href={`/blog/${post.slug}/`}
            class:list={[
              "relative -mx-4 flex h-full flex-col px-4 py-4 transition-all duration-300 ease-out group-hover:-translate-y-1",
              index > 0 ? "border-t border-white/10 pt-8 lg:border-t-0 lg:pt-4" : "",
            ]}
          >
            <p class="text-sm text-zinc-500 transition-colors duration-300 group-hover:text-zinc-400">
              <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            </p>
            <h3 class="mt-4 text-xl font-[720] leading-tight tracking-[-0.04em] text-white transition-colors duration-300 group-hover:text-zinc-200 sm:text-2xl">
              {post.title}
            </h3>
            <p class="mt-4 leading-7 text-zinc-400 transition-colors duration-300 group-hover:text-zinc-300">
              {post.description}
            </p>
            <div class="mt-auto pt-6">
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-orange-300 transition duration-300 group-hover:text-orange-200">
                Read post
                <ArrowRight size={16} stroke-width={2.5} aria-hidden="true" />
              </span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
