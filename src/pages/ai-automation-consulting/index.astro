---
import { Font, getImage } from "astro:assets";
import { ClipboardList, Workflow, UserMinus, Sparkles, TrendingUp, AlertTriangle } from '@lucide/astro';
import ConsultancyLayout from "../../layouts/ConsultancyLayout.astro";
import Divider from "../../components/Divider.astro"
import profilePicture from "../../assets/images/new_profile_picture.png";

const optimizedBg = await getImage({ src: profilePicture });
const title = "AI & Automation Consulting";
const description =
  "An independent systems architect helping traditional mid-size companies eliminate operational bottlenecks with reliable, agentic AI workflows and a measurable ROI.";

const bottleneckItems = [
  {
    icon: ClipboardList,
    title: "MANUAL, REPETITIVE TASKS",
    step: "--motion-step: 4",
    cls: "lg:pr-6 lg:pt-5",
    body:
      "Your team re-types data between systems, copies records by hand, and runs the same routine every day. That time is the first thing a well-designed automation gives back.",
  },
  {
    icon: Workflow,
    title: "OPERATIONAL BOTTLENECKS",
    step: "--motion-step: 5",
    cls: "lg:px-6 lg:pt-5",
    body:
      "Critical processes stall because they depend on a few people manually moving work between disconnected tools. We map the flow of value and find where time and money leak.",
  },
  {
    icon: UserMinus,
    title: "NO INTERNAL TECH TALENT",
    step: "--motion-step: 4",
    cls: "lg:pl-6 lg:pt-5",
    body:
      "You don't have the in-house engineering to design and connect AI into your systems safely. You need an independent architect, not another full-time hire.",
  },
  {
    icon: Sparkles,
    title: "AI WITHOUT A REAL PLAN",
    step: "--motion-step: 4",
    cls: "lg:pr-6",
    body:
      "Adopting AI out of FOMO, with no concrete, measurable plan, is how most companies see zero return. The goal here is operational impact, not a tech demo.",
  },
  {
    icon: TrendingUp,
    title: "GROWTH CHAINED TO HEADCOUNT",
    step: "--motion-step: 5",
    cls: "lg:px-6",
    body:
      "Every increase in volume means hiring more people to run the same manual work. Automating the bottleneck breaks the link between growth and payroll.",
  },
  {
    icon: AlertTriangle,
    title: "COSTLY HUMAN ERRORS",
    step: "--motion-step: 5",
    cls: "lg:pl-6",
    body:
      "Routine manual work produces mistakes that require rework, create compliance risk, and erode trust. Reliable, agentic workflows reduce that error surface.",
  },
];

const processSteps = [
  {
    title: "Operational diagnosis",
    body: "A focused 90-minute strategy session with your operational leadership, centered on the business and not the technology. We map your most painful processes, measure the volume of repetitive tasks, and quantify the impact of your critical bottlenecks.",
  },
  {
    title: "Architecture and feasibility",
    body: "Internal, asynchronous work where I cross your operational problems with the real capabilities of current AI: language models, agentic automation, and integrations. I design exactly how your existing systems should connect to AI agents, and calculate the time savings and technical viability.",
  },
  {
    title: "Blueprint presentation",
    body: "An executive session to deliver and explain the results. I present the operational diagnosis, reveal the quantified cost of inaction, and hand over the structured action plan and technical blueprint, so you can move toward a safe, delegable implementation.",
  },
];
---

<Font cssVariable="--font-editorial-new" preload />
<ConsultancyLayout title={title} description={description} headerTransparent={true}>

  <section class="motion-enter h-[calc(100dvh - 73px)] pt-18.25" data-ai-automation-landing>
    <div class="mx-auto flex lg:min-h-[clamp(800px,78svh,800px)] w-full items-center">
      <div class="max-w-4xl space-y-7">
        <p class="motion-enter text-sm font-semibold uppercase tracking-widest text-orange-300" style="--motion-step: 0;">
          AI &amp; automation advisory
        </p>

        <div class="space-y-5">
          <h1 class="motion-enter max-w-4xl text-5xl font-bold tracking-tight text-balance text-white lg:text-8xl font-(family-name:--font-editorial-new)" style="--motion-step: 1;">
            AI &amp; Automation Consulting
          </h1>
          <p class="motion-enter max-w-2xl text-lg leading-8 text-pretty text-zinc-200 sm:text-[1.35rem] sm:leading-9" style="--motion-step: 2;">
            I help traditional companies find their operational bottlenecks and design agentic AI workflows that cut manual work, reduce errors, and deliver a measurable ROI, without inflating your payroll
          </p>
        </div>

        <div class="motion-enter flex flex-col gap-3 pt-2 sm:flex-row" style="--motion-step: 3;">
          <a
            href="#apply"
            data-ai-automation-cta="hero_apply_section"
            class="interactive-chip inline-flex items-center justify-center rounded-full bg-orange-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-orange-200"
          >
            Apply for a diagnosis
          </a>
          <a
            href="#process"
            class="interactive-chip inline-flex items-center justify-center rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/30 hover:bg-white/10"
          >
            See the process
          </a>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- Who am I -->
  <section aria-labelledby="who-am-i-heading" class="motion-enter">
    <div class="relative overflow-hidden rounded-tr-xl rounded-br-xl">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-0 -top-5 -bottom-5 hidden w-85 bg-cover bg-center bg-no-repeat lg:block mask-l-from-15% mask-l-to-100%"
        style={`background-image: url('${optimizedBg.src}');`}
      />
      <div class="relative z-10 lg:max-w-3xl lg:py-8">
        <h2 id="who-am-i-heading" class="mb-5 text-3xl font-[720] tracking-tight text-white md:text-4xl lg:text-6xl text-center lg:text-left font-(family-name:--font-editorial-new)">
          Who am I
        </h2>
        <div class="space-y-4 text-center lg:space-y-5 lg:text-left">
          <p class="leading-7 text-zinc-300 sm:text-lg sm:leading-8 lg:text-[1.14rem] lg:leading-8">
            Software engineer with 15+ years of experience building and integrating complex systems for companies across Silicon Valley and the rest of the world. I act as your independent systems architect, focused on operational reality over hype.
          </p>
          <p class="leading-7 text-zinc-300 sm:text-lg sm:leading-8 lg:text-[1.14rem] lg:leading-8">
            I design AI and automation the same way I design any production system: reliable, fail-safe, secure, and built only where there is a true reason for it to exist and a return to justify it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- When AI actually delivers ROI -->
  <section class="motion-enter">
    <h2 class="mb-14 text-3xl font-[720] tracking-tight text-balance text-white md:text-4xl lg:text-6xl text-center font-(family-name:--font-editorial-new)">
      When AI actually <em>delivers</em> a return
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-5 gap-y-15">
      {bottleneckItems.map((item) => {
        const Icon = item.icon;
        return (
          <div class={`mx-auto w-4/5 lg:w-full ${item.cls}`} style={item.step}>
            <div class="justify-center flex items-center mb-5">
              <Icon class="text-orange-300 mr-5 hidden sm:block" />
              <h3 class="text-center lg:text-left text-base font-semibold uppercase tracking-widest text-orange-300">
                {item.title}
              </h3>
            </div>
            <p class="text-center lg:text-left">{item.body}</p>
          </div>
        );
      })}
    </div>
  </section>

  <Divider />

  <!-- Process -->
  <section id="process" class="motion-enter">
    <div class="mx-auto w-full">
      <div class="space-y-5">
        <div class="motion-enter" style="--motion-step: 1;">
          <h2 class="text-3xl font-bold tracking-tight text-balance text-white md:text-4xl lg:text-6xl font-(family-name:--font-editorial-new) mb-8">
            From operational pain to a delegable blueprint.
          </h2>
        </div>

        <ol class="m-0 p-0 list-none">
          {processSteps.map((step, index) => (
            <li class="motion-enter grid gap-4 grid-cols-[2rem_minmax(0,1fr)]" style={`--motion-step: ${index + 2};`}>
              <div class="relative flex justify-center pt-[0.35rem]" aria-hidden="true">
                <span class="relative z-1 h-3.5 w-3.5 rounded-full bg-[rgb(253_186_116)] [box-shadow:0_0_0_0.5rem_rgb(253_186_116/0.08)]" />
                {index < processSteps.length - 1 && <span class="absolute top-5 bottom-0 w-px bg-[linear-gradient(180deg,rgb(253_186_116/0.6),rgb(255_255_255/0.08))]" />}
              </div>
              <div class="space-y-3 pb-10">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-300">
                  Phase 0{index + 1}
                </p>
                <h3 class="text-2xl font-[720] tracking-[-0.04em] text-white">
                  {step.title}
                </h3>
                <p class="leading-6 text-zinc-400 sm:text-lg sm:leading-8">
                  {step.body}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Divider />

  <!-- Who is this for -->
  <section aria-labelledby="fit-heading" class="motion-enter">
    <h2 id="fit-heading" class="mb-5 text-3xl font-[720] tracking-tight text-white md:text-4xl lg:text-6xl text-center font-(family-name:--font-editorial-new)">
      Who is this for
    </h2>
    <p class="leading-7 text-pretty text-zinc-300 sm:text-lg sm:leading-8 text-center">
      Best fit for traditional mid-size companies, roughly 50 to 500 employees, in sectors like
      logistics, finance, legal, or manufacturing, that are losing time and money to manual,
      repetitive work and lack the internal tech talent to fix it.<br />
      Designed for operational leaders who want a concrete, measurable AI plan, not another bet placed blindly on the hype.
    </p>
  </section>

  <Divider />

  <!-- Apply -->
  <section id="apply" class="motion-enter">
    <div class="motion-enter" style="--motion-step: 0;">
      <h2 class="text-3xl font-[760] tracking-tight text-balance text-white md:text-4xl lg:text-6xl font-(family-name:--font-editorial-new)">
        If the bottleneck is costing you, start with the context
      </h2>
      <p class="mt-4 leading-7 text-pretty text-zinc-300 sm:text-lg sm:leading-8">
        The application covers your operational reality, the repetitive work that's slowing you down, and the systems involved, so I can assess whether automation can deliver a real return before any session is scheduled.
      </p>
      <div class="flex flex-col gap-5 pt-8 md:flex-row">
        <a
          href="/ai-automation-consulting/apply"
          data-ai-automation-cta="apply_page"
          class="interactive-chip mt-6 inline-flex items-center justify-center rounded-full bg-orange-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-orange-200"
        >
          Apply for a diagnosis
        </a>
      </div>
    </div>
  </section>
</ConsultancyLayout>

<script>
  const trackAIAutomationLanding = () => {
    const landingRoot = document.querySelector("[data-ai-automation-landing]");

    if (!(landingRoot instanceof HTMLElement) || landingRoot.dataset.analyticsInitialized === "true") {
      return;
    }

    landingRoot.dataset.analyticsInitialized = "true";
    // @ts-expect-error
    const sendGtagEvent = (eventName, eventParams) => {
      // @ts-expect-error
      if (typeof window.gtag !== "function") {
        return;
      }
      // @ts-expect-error
      window.gtag("event", eventName, eventParams);
    };

    sendGtagEvent("ai_automation_landing_view", {
      page_path: window.location.pathname,
      page_type: "landing",
    });

    const ctaLinks = document.querySelectorAll("[data-ai-automation-cta]");

    ctaLinks.forEach((ctaLink) => {
      if (!(ctaLink instanceof HTMLAnchorElement)) {
        return;
      }

      ctaLink.addEventListener("click", () => {
        sendGtagEvent("ai_automation_apply_cta_click", {
          cta_location: ctaLink.dataset.aiAutomationCta,
          destination_path: ctaLink.getAttribute("href") || "",
          page_path: window.location.pathname,
        });
      });
    });
  };

  trackAIAutomationLanding();
  document.addEventListener("astro:page-load", trackAIAutomationLanding);
</script>
